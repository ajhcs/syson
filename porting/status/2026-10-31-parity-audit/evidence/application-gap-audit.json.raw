  "gaps": [
    {
      "id": "APP01",
      "title": "Rust application host and transport assembly",
      "classification": "MISSING_CURRENT_MAIN_APPLICATION_ASSEMBLY",
      "existing": "The23 Rust production crates expose libraries. The active Rust catalog executable emits a PHYSICAL_LIBRARY_CATALOGUE_ONLY JSON resource catalog. The checked-in user application starts Spring Boot and renders React SiriusWebApplication.",
      "missing": "A Rust production host that owns HTTP/GraphQL request execution, session/security admission, editing contexts, WebSocket/subscriptions and clean process lifecycle is not assembled in the current23 crate manifests or active entrypoints.",
      "evidence": [
        "crate_inventory",
        "catalog_cli",
        "spring_entry",
        "react_entry",
        "frontend_manifest"
      ],
      "units": [
        "B02",
        "B03",
        "B04",
        "B15",
        "B16",
        "B29",
        "B32",
        "C04"
      ],
      "verification": [
        "Build the exact reviewed Rust host artifact and drive the native-matched method/status/header/error and GraphQL coercion corpus through real loopback sockets.",
        "Exercise security/session/CORS/CSRF, bounded requests, cancellation, disconnect, actor drain and startup failure. Inspect actual artifact dependencies and live process tree.",
        "Production application closure must satisfy the contract's Rust delivery target; inherited Java/React execution or test-only library invocation does not establish that closure."
      ],
      "boundary": "Confirmed source assembly gap in this pinned tree. No server was launched; no observed current runtime failure is claimed."
    },
    {
      "id": "APP02",
      "title": "Atomic durable project store and recovery",
      "classification": "EXISTING_LOCAL_SNAPSHOT_AND_PURE_PREPARATION_MISSING_PROJECT_BACKEND",
      "existing": "SnapshotStore performs bounded canonical Document writes using exclusive staging, file sync, no-replace hard-link publication, directory sync and staging removal. Regular-file read admission and injectable SnapshotIo failure contracts exist. Persistence helpers transform library identities. Migration preparation returns a cloned Project; DocumentReconcile returns requested effects.",
      "missing": "No Rust SQL/project service composes semantic documents, representation content/metadata, revisions and migration watermarks into one durable transaction. SnapshotStore stores a single Document under an immutable caller key; it does not supply the native project database, transaction/CAS protocol, project listing or representation store.",
      "evidence": [
        "snapshot_store",
        "snapshot_io",
        "persistence_scope",
        "migration_prepare",
        "reconcile_effects",
        "compose_manifest"
      ],
      "units": [
        "B01",
        "B05",
        "B06",
        "B07",
        "B27",
        "B28",
        "RR11",
        "RR12",
        "RR13",
        "RR13a",
        "RR13b"
      ],
      "verification": [
        "Capture exact native PostgreSQL catalog/migration/isolation contract before implementing B05/B06; preserve all schema/driver/error obligations.",
        "Persist semantic documents, representations, metadata and migration watermarks together with actual stale-observation and read-only/project-isolation enforcement.",
        "Inject failures before/between/after durable writes, at commit and before acknowledgment; inspect the result through a fresh connection and a restarted owned backend.",
        "Keep uncertain commit outcome explicit. SnapshotIo documents possible side effects on error; an error or visible file alone does not prove nonpublication or durability."
      ],
      "boundary": "Local filesystem implementation is present. Backend atomicity and crash/restart acceptance are separate missing integration and unrun qualification, not disproved by unit success."
    },
    {
      "id": "APP03",
      "title": "Connected import/edit/save/reload/reopen lifecycle",
      "classification": "EXISTING_FINITE_MODEL_LIBRARIES_MISSING_PRODUCT_CALLER",
      "existing": "Importer stages and commits a real finite selected-model transaction, with Package/PartDefinition/PartUsage construction and FeatureTyping linking. Editor offers model transactions. Current workflow connected.rs performs create/type/cancel/undo/save/load and rotate, but store reopening is within one test process.",
      "missing": "Current-main Importer and SnapshotStore references are tests/examples; no inspected application entrypoint connects those APIs to project commands, file import/export and persistent reopening. The saved value is not automatically restored by a Rust product route after page reload or backend restart.",
