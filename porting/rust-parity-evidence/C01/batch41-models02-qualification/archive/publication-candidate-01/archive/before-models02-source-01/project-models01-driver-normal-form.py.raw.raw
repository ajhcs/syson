from pathlib import Path
import hashlib
import json
import subprocess

w = Path('/workspace/worktrees/builderbob/syson/batch41-native-core-closure-20261031')
b = Path('/workspace/build/builderbob/syson-durable-batch41-20261031')
s = json.loads((b / 'network-models01-spec.json').read_bytes())
src = Path(s['out'])
dst = b / 'models01-public-projected'
assert not dst.exists()
projector = w / 'porting/rust-parity-evidence/C01/batch34-direct-core/project_metadata.py'
assert hashlib.sha256(projector.read_bytes()).hexdigest() == '26819c7fc1235a9f811b3d47df974d5e9615e75a0e632a653b114904b2cbfdd9'
records = []
for p in [src / 'receipt.json', *sorted(src.rglob('*.response.json'))]:
    q = dst / p.relative_to(src)
    q.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ['/usr/bin/python3', '-I', '-B', str(projector), str(p), str(q)],
        check=True,
    )
    records.append({
        'source': str(p),
        'source_sha256': hashlib.sha256(p.read_bytes()).hexdigest(),
        'destination': str(q),
        'destination_sha256': hashlib.sha256(q.read_bytes()).hexdigest(),
        'bytes': q.stat().st_size,
    })
assert len(records) == 176
(b / 'public-projection-models01-map.json').write_text(json.dumps({
    'status': 'PROJECTED_METADATA_ONLY_PRIVATE_ORIGINALS_RETAINED',
    'projector_sha256': hashlib.sha256(projector.read_bytes()).hexdigest(),
    'files': records,
}, indent=2) + '\n')
print(json.dumps({
    'files': len(records),
    'bytes': sum(r['bytes'] for r in records),
    'root_new_projection_driver_lines_to_count': 10,
    'projector_reused_unchanged_lines': 29,
}))
