  "descriptor": {
    "artifact": "maven-help-plugin",
    "version": "3.5.1",
    "mojos": [
      {
        "goal": "active-profiles",
        "description": "Displays a list of the profiles which are currently active for this build.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "true",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.ActiveProfilesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "false"
      },
      {
        "goal": "all-profiles",
        "description": "Displays a list of available profiles under the current project. \nNote: it will list all profiles for a project. If a profile comes up with a status inactive then there might be a need to set profile activation switches/property.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.AllProfilesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.1",
        "threadSafe": "false"
      },
      {
        "goal": "describe",
        "description": "Displays a list of the attributes for a Maven Plugin and/or goals (aka Mojo - Maven plain Old Java Object).\nSee also: What is a Mojo? <http://maven.apache.org/general.html#What_is_a_Mojo>",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "true",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.DescribeMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "false"
      },
      {
        "goal": "effective-pom",
        "description": "Displays the effective POM as an XML for this build, with the active profiles factored in, or a specified artifact. If verbose, a comment is added to each XML element describing the origin of the line.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "true",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.EffectivePomMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "false"
      },
      {
        "goal": "effective-settings",
        "description": "Displays the calculated settings as XML for this project, given any profile enhancement and the inheritance of the global settings into the user-level settings.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.EffectiveSettingsMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "false"
      },
      {
        "goal": "evaluate",
        "description": "Evaluates Maven expressions given by the user in an interactive mode.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.EvaluateMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.1",
        "threadSafe": "false"
      },
      {
        "goal": "help",
        "description": "Display help information on maven-help-plugin. \nCall mvn help:help -Ddetail=true -Dgoal=<goal-name> to display parameter details.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.HelpMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "threadSafe": "true"
      },
      {
        "goal": "system",
        "description": "Displays a list of the platform details like system properties and environment variables.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.help.SystemMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.1",
        "threadSafe": "false"
      }
    ],
