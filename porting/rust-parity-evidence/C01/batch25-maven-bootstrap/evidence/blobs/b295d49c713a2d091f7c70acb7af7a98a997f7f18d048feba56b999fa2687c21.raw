  "descriptor": {
    "artifact": "maven-dependency-plugin",
    "version": "3.11.0",
    "mojos": [
      {
        "goal": "add",
        "description": "Adds a dependency to the project's pom.xml. Supports adding to <dependencies> or <dependencyManagement>, with version inference from managed dependencies. \nIf the dependency already exists, the goal fails with a descriptive error directing the user to remove it first.\n\nThe goal uses formatting-preserving DOM manipulation to maintain the POM's existing structure (comments, indentation, encoding). Duplicate detection uses type and classifier-aware matching, and cross-references Maven's resolved model to catch dependencies declared via property references.\n\nScope values are validated against Maven's known scopes: compile, provided, runtime, test, system, import.\n",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.AddDependencyMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "3.11.0",
        "threadSafe": "true"
      },
      {
        "goal": "analyze",
        "description": "Analyzes the dependencies of this project and determines which are: used and declared; used and undeclared; unused and declared. This goal is intended to be used standalone. Thus, it always executes the test-compile phase. Use the dependency:analyze-only goal instead when participating in the build lifecycle. \nBy default, maven-dependency-analyzer <https://maven.apache.org/shared/maven-dependency-analyzer/> is used to perform the analysis, with limitations due to the fact that it works at bytecode level, but any analyzer can be plugged in through analyzer parameter.\n\nSee also: AnalyzeOnlyMojo",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "executePhase": "test-compile",
        "implementation": "org.apache.maven.plugins.dependency.analyze.AnalyzeMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0-alpha-3",
        "threadSafe": "true"
      },
      {
        "goal": "analyze-dep-mgt",
        "description": "This mojo looks at the dependencies after final resolution and looks for mismatches in your dependencyManagement section. This mojo is also useful for detecting projects that override the dependencyManagement directly. Set ignoreDirect to false to detect these otherwise normal conditions.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.analyze.AnalyzeDepMgt",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0-alpha-3",
        "threadSafe": "true"
      },
      {
        "goal": "analyze-duplicate",
        "description": "Analyzes the <dependencies/> and <dependencyManagement/> tags in the pom.xml and determines the duplicate declared dependencies.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.analyze.AnalyzeDuplicateMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "threadSafe": "true"
      },
      {
        "goal": "analyze-exclusions",
        "description": "Analyzes the exclusions defined on dependencies in this project and reports if any of them are unneeded. \nRelevant use case is when an artifact in a later version has removed usage of a dependency, making the exclusion no longer necessary.\n",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.exclusion.AnalyzeExclusionsMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "3.7.0",
        "requiresDependencyCollection": "test",
        "threadSafe": "true"
      },
      {
        "goal": "analyze-only",
        "description": "Analyzes the dependencies of this project and determines which are: used and declared; used and undeclared; unused and declared. This goal is intended to be used in the build lifecycle, thus it assumes that the test-compile phase has been executed - use the dependency:analyze goal instead when running standalone. \nBy default, maven-dependency-analyzer <https://maven.apache.org/shared/maven-dependency-analyzer/> is used to perform the analysis, with limitations due to the fact that it works at bytecode level, but any analyzer can be plugged in through analyzer parameter.\n\nSee also: AnalyzeMojo",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "verify",
        "implementation": "org.apache.maven.plugins.dependency.analyze.AnalyzeOnlyMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "true"
      },
      {
        "goal": "analyze-report",
        "description": "Analyzes the dependencies of this project and produces a report that summarizes which are: used and declared; used and undeclared; unused and declared.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "executePhase": "test-compile",
        "implementation": "org.apache.maven.plugins.dependency.analyze.AnalyzeReport",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0-alpha-5",
        "threadSafe": "true"
      },
      {
        "goal": "build-classpath",
        "description": "This goal outputs a classpath string of dependencies from the local repository to a file or log.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "generate-sources",
        "implementation": "org.apache.maven.plugins.dependency.fromDependencies.BuildClasspathMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0-alpha-2",
        "threadSafe": "true"
      },
      {
        "goal": "collect",
        "description": "\nGoal that collects the project dependencies from the repository. This goal uses \"requiresDependencyCollection\" to list the groupId:artifactId:version information by downloading the pom files without downloading the actual artifacts such as jar files.\n\nThis is very useful when full dependency resolution might fail due to projects which haven't been built yet.\n\nIt is identical to resolve <https://maven.apache.org/plugins/maven-dependency-plugin/resolve-mojo.html> except for using the requiresDependencyCollection annotation attribute instead of requiresDependencyResolution.\n",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "generate-sources",
        "implementation": "org.apache.maven.plugins.dependency.resolvers.CollectDependenciesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "3.0",
        "requiresDependencyCollection": "test",
        "threadSafe": "true"
      },
      {
        "goal": "copy",
        "description": "Goal that copies a list of artifacts from the repository to defined locations.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "process-sources",
        "implementation": "org.apache.maven.plugins.dependency.fromConfiguration.CopyMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "1.0",
        "threadSafe": "true"
      },
      {
        "goal": "copy-dependencies",
        "description": "Goal that copies the files for a project's dependencies from the repository to a directory. The default location to copy to is target/dependencies. Since all files are copied to the same directory by default, a dependency that has the same file name as another dependency will be overwritten.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "process-sources",
        "implementation": "org.apache.maven.plugins.dependency.fromDependencies.CopyDependenciesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "1.0",
        "threadSafe": "true"
      },
      {
        "goal": "display-ancestors",
        "description": "Displays all ancestor POMs of the project. This may be useful in a continuous integration system where you want to know all parent poms of the project.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "validate",
        "implementation": "org.apache.maven.plugins.dependency.DisplayAncestorsMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.9",
        "threadSafe": "true"
      },
      {
        "goal": "get",
        "description": "Resolves a single artifact, eventually transitively, from the specified remote repositories. Caveat: will always check the central repository defined in the super pom. You could use a mirror entry in your settings.xml",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.GetMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "threadSafe": "true"
      },
      {
        "goal": "go-offline",
        "description": "Goal that resolves all project dependencies, including plugins and reports and their dependencies.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.resolvers.GoOfflineMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "true"
      },
      {
        "goal": "help",
        "description": "Display help information on maven-dependency-plugin. \nCall mvn dependency:help -Ddetail=true -Dgoal=<goal-name> to display parameter details.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.maven_dependency_plugin.HelpMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "threadSafe": "true"
      },
      {
        "goal": "list",
        "description": "Displays the list of dependencies for this project.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.resolvers.ListMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0-alpha-5",
        "threadSafe": "true"
      },
      {
        "goal": "list-classes",
        "description": "Retrieves and lists all classes contained in the specified artifact from the specified remote repositories.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.ListClassesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "3.1.3",
        "threadSafe": "true"
      },
      {
        "goal": "list-repositories",
        "description": "Goal that collects all project dependencies and then lists the repositories used by the build and by the transitive dependencies.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.ListRepositoriesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.2",
        "threadSafe": "true"
      },
      {
        "goal": "properties",
        "description": "Goal that sets a property pointing to the artifact file for each project dependency. For each dependency (direct and transitive) a project property will be set which follows the groupId:artifactId:type:[classifier] form and contains the path to the resolved artifact.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "initialize",
        "implementation": "org.apache.maven.plugins.dependency.PropertiesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.2",
        "threadSafe": "true"
      },
      {
        "goal": "purge-local-repository",
        "description": "When run on a project, remove the project dependencies from the local repository, and optionally re-resolve them. Outside of a project, remove the manually given dependencies.",
        "requiresDirectInvocation": "false",
        "requiresProject": "false",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.PurgeLocalRepositoryMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "2.0",
        "threadSafe": "true"
      },
      {
        "goal": "remove",
        "description": "Removes a dependency from the project's pom.xml. Supports removing from <dependencies> or <dependencyManagement>. \nMatching uses groupId, artifactId, type, and classifier for precision. If the dependency exists in Maven's resolved model but uses property references in the raw POM, a clear error directs the user to edit manually.\nWhen removing a managed dependency from a parent POM, warns if child modules reference it without an explicit version.",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "implementation": "org.apache.maven.plugins.dependency.RemoveDependencyMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "3.11.0",
        "threadSafe": "true"
      },
      {
        "goal": "render-dependencies",
        "description": "This goal renders dependencies based on a velocity template.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
        "aggregator": "false",
        "requiresOnline": "false",
        "inheritedByDefault": "true",
        "phase": "generate-sources",
        "implementation": "org.apache.maven.plugins.dependency.fromDependencies.RenderDependenciesMojo",
        "language": "java",
        "instantiationStrategy": "per-lookup",
        "executionStrategy": "once-per-session",
        "since": "3.9.0",
        "threadSafe": "true"
      },
      {
        "goal": "resolve",
        "description": "Goal that resolves the project dependencies from the repository. When running on Java 9, the module names will be visible as well.",
        "requiresDependencyResolution": "test",
        "requiresDirectInvocation": "false",
        "requiresProject": "true",
        "requiresReports": "false",
