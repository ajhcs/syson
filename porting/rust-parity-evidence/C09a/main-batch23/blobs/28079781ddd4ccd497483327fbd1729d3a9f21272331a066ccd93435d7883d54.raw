"""Admit the two frozen P01 capture epochs and their declared input closure.

No semantic comparison, execution-causality or native/UI acceptance follows.
Factored from frozen prototype SHA-256
56e59184a7190cc6beffc7f5e413e4fbff9ff9b965f02740b976accce931ec5f.
"""
import hashlib
import importlib.util
import json
import math
import re
from pathlib import Path

SELECTED = {'Namespace', 'Package', 'PartDefinition', 'PartUsage'}
CONSTRUCTOR_SHA256 = '3d7d2451ff2300510cda71ad6c5debee6fab47193277d8c1292f2490eb7874d6'
KERNEL_SHA256 = '07e1e2ebe11f58c50f3c065e0ead4b2e2a7e8c8cb4cc464e26e715d4970fa99b'
BUNDLE_SHA256 = '47d8fe11fda1b58b6257463087f663be953c2ab6c2b5e1e2ccc44161ed5cd0bd'
CORPORA = {
    '971dcf43457b511ee7f7df99b676c38179a6450b3241caf66d7a9682320982ca':
        (15, 'd4212968de38e574f8aebe8f5c64b9245115a36f057a7e5d46c8654702d0e348'),
    'c5fce29e6ac91d6d0c65ad657edfb12f20fe7bdc5a408ca3deaef6816a714cc6':
        (25, '17d3985d0f5b64430715bda98c4ce8b211db22c916a52184b14b736232b0adb2'),
}
PROVENANCE_PINS = {
    'bundle_sha256': BUNDLE_SHA256,
    'source_baseline': '6ba2ac64e6b16ee2b05752ad55395eebb87d4910',
    'source_candidate': '1326f234cae23b0e4777d5a48a069b17e9e332f1',
    'evaluated_prefix_sha256': '66c595799e42dec782d6f2a067ba7bd6b71ceb34917d35081e5d72a922a280b4',
    'evaluated_prefix_bytes': 4106536,
    'embedded_module_sha256': {
        '../syside-languageserver/lib/sysml-module.js': '4dbbd7a940fd07186c3a8b9312b4fd3d616f03a5cebb204ce7be579398fe4186',
        '../syside-languageserver/lib/services/shared/workspace/file-system-provider.js': '9cb3100ef0a2db99d65741ce66f90f96295a29affa268a1fdc0dea362883e0e4',
        '../syside-languageserver/lib/services/parser/parser.js': 'ced8f9cab928606d13a323bcaca8693025c2ae381fd9ed2b0bcf27b45707991e',
    },
}
RESTRICTIONS = {
    '07-semantic-block-comment': ('Unsupported', 0, None),
    '08-overlap-multiline-note': ('Unsupported', 0, None),
    'late-overlap': ('Unsupported', 19, None),
}
RECOVERIES = {
    '09-commented-closing-brace': ('Malformed', 21, '}'),
    '10-no-token-merging': ('Unsupported', 0, None),
    'quoted-error-offset': ('Malformed', 36, 'closing name quote'),
}
UNEVALUATED = {'kind': 'unevaluated_accessor'}


def require(ok, message):
    if not ok:
        raise ValueError(message)


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def strict_loads(raw):
    def pairs(items):
        result = dict(items)
        require(len(result) == len(items), 'duplicate JSON key')
        return result
    def invalid_constant(value):
        raise ValueError('invalid JSON number: ' + value)
    def finite_float(value):
        parsed = float(value)
        require(math.isfinite(parsed), 'overflowing JSON number')
        return parsed
    return json.loads(raw, object_pairs_hook=pairs, parse_constant=invalid_constant,
                      parse_float=finite_float)


def units(text):
    raw = text.encode('utf-16-le', 'surrogatepass')
    return [int.from_bytes(raw[i:i + 2], 'little') for i in range(0, len(raw), 2)]


def keys(value, expected, label):
    require(type(value) is dict and set(value) == set(expected), label + ' keys')


def strings(value, label):
    require(type(value) is list and all(type(v) is str for v in value) and
            len(value) == len(set(value)), label + ' string inventory')


def unique(rows, label):
    require(type(rows) is list and all(type(r) is dict and
            type(r.get('id')) is str and r['id'] for r in rows), label + ' ID schema')
    result = {r['id']: r for r in rows}
    require(len(result) == len(rows), label + ' duplicate ID')
    return result


def validate_corpus(corpus):
    keys(corpus, {'schema', 'scope', 'cases'}, 'corpus')
    require(type(corpus['schema']) is int and corpus['schema'] == 1 and
            type(corpus['scope']) is str, 'corpus schema')
    cases = unique(corpus['cases'], 'corpus')
    canonical = digest(json.dumps(corpus, sort_keys=True, separators=(',', ':'),
                                 ensure_ascii=False).encode())
    allowed = [sha for sha, (count, expected) in CORPORA.items()
               if len(cases) == count and canonical == expected]
    require(len(allowed) == 1, 'pinned complete corpus IDs/order/source/metadata changed')
    for case in cases.values():
        keys(case, {'id', 'source', 'origin'}, 'corpus case')
        require(type(case['source']) is str and type(case['origin']) is str,
                'corpus source/origin strings')
    return allowed[0], cases


def validate_provenance(native, corpus_sha, count):
    keys(native, {'cases', 'provenance'}, 'native capture')
    provenance = native['provenance']
    require(type(provenance) is dict, 'native provenance object')
    for name, expected in PROVENANCE_PINS.items():
        require(type(provenance.get(name)) is type(expected) and
                provenance[name] == expected, 'native provenance pin: ' + name)
    require(provenance.get('corpus_sha256') == corpus_sha and
            type(provenance.get('corpus_cases')) is int and
            provenance['corpus_cases'] == count, 'native corpus binding mismatch')


def constructor_bytes(raw):
    require(digest(raw) == CONSTRUCTOR_SHA256, 'constructor comparator source hash mismatch')


def load_constructor(path):
    raw = path.read_bytes()
    constructor_bytes(raw)
    spec = importlib.util.spec_from_file_location('p01_pinned_constructor', path)
    require(spec is not None and spec.loader is not None, 'constructor comparator import spec')
    module = importlib.util.module_from_spec(spec)
    exec(compile(raw, str(path), 'exec'), module.__dict__)
    require(callable(module.validate_rust_capture), 'public Rust capture validator unavailable')
    return module.validate_rust_capture


def validate_receipt(receipt, native, corpus_sha):
    require(type(receipt) is dict and receipt.get('source_unchanged') is True,
            'Rust qualification source drift or absent receipt')
    before, prepared, after = (receipt[name] for name in
                               ['inputs_before', 'prepared_inputs_before', 'inputs_after'])
    for mapping in [before, prepared, after]:
        require(type(mapping) is dict and mapping and all(type(k) is str and
                type(v) is str and re.fullmatch('[0-9a-f]{64}', v)
                for k, v in mapping.items()), 'qualification input hash map')
    require(prepared == after and all(after.get(k) == v for k, v in before.items()),
            'qualification prepared/source input closure changed')
    for suffix, expected in [
        ('rust/crates/syson-ast/src/lib.rs', KERNEL_SHA256),
        ('backend/application/syson-sysml-import/src/main/resources/syside-cli.js', BUNDLE_SHA256),
        ('porting/rust-parity-evidence/C09/batch21-constructor-tools/compare_construction.py', CONSTRUCTOR_SHA256),
    ]:
        matches = [value for path, value in after.items() if path.endswith('/' + suffix)]
        require(matches and all(value == expected for value in matches),
                'qualification source pin: ' + suffix)
    commands = receipt['commands']
    require(type(commands) is list and all(type(c) is dict for c in commands),
            'qualification commands schema')
    selected = [c for c in commands if c.get('label') == 'rust-comments']
    require(len(selected) == 1, 'one recorded Rust comments invocation required')
    command = selected[0]
    require(type(command.get('exit')) is int and command['exit'] == 0 and
            type(command.get('expected_exit')) is int and command['expected_exit'] == 0 and
            command.get('timed_out') is False, 'Rust comments invocation did not succeed')
    argv = command['argv']
    require(type(argv) is list and len(argv) >= 2 and all(type(v) is str for v in argv) and
            argv[-2] == '--' and after.get(argv[-1]) == corpus_sha and
            native['provenance'].get('corpus_path') == argv[-1],
            'qualification Rust/native corpus invocation binding mismatch')
    return {'kernel_sha256': KERNEL_SHA256, 'corpus_sha256': corpus_sha,
            'recorded_rust_argv': argv,
            'limit': 'Receipt input/command declarations are checked. The receipt has no output digest; capture-to-execution causality requires independent artifact/stdout review.'}


def props(record):
    rows = record['properties']
    strings(record['property_keys'], 'native property keys')
    require(type(rows) is list, 'native property rows')
    result = {}
    for row in rows:
        require(type(row) is dict and type(row.get('key')) is str and
                type(row.get('descriptor')) is dict, 'native property/descriptor schema')
        descriptor = row['descriptor']
        if 'writable' in descriptor:
            keys(row, {'key', 'descriptor', 'value'}, 'native data property')
            keys(descriptor, {'enumerable', 'configurable', 'writable'}, 'native data descriptor')
            result[row['key']] = row['value']
        else:
            keys(row, {'key', 'descriptor'}, 'native accessor property')
            keys(descriptor, {'enumerable', 'configurable', 'accessor', 'getter', 'setter'},
                 'native accessor descriptor')
            require(descriptor['accessor'] is True, 'native accessor marker')
            result[row['key']] = UNEVALUATED
        require(all(type(v) is bool for v in descriptor.values()), 'native descriptor flags')
    require([r['key'] for r in rows] == record['property_keys'] and len(result) == len(rows),
            'native duplicate/missing/ordered property inventory')
    return result


def native_span(source, span):
    keys(span, {'offset', 'end', 'length', 'range', 'text', 'hidden'}, 'native CST span')
    start, end = span['offset'], span['end']
    require(type(start) is int and type(end) is int and
            0 <= start <= end <= len(units(source)), 'native CST extent schema')
    raw = source.encode('utf-16-le', 'surrogatepass')
    prefix = raw[:start * 2].decode('utf-16-le')
    text = raw[start * 2:end * 2].decode('utf-16-le')
    require(type(span['length']) is int and span['length'] == end - start and
            type(span['hidden']) is bool and type(span['text']) is str and span['text'] == text,
            'native CST/source mismatch')
    return {'bytes': [len(prefix.encode()), len((prefix + text).encode())],
            'utf16': [start, end], 'text': text}


def rust_span(source, span):
    keys(span, {'bytes', 'utf16', 'text'}, 'Rust source lexeme')
    bounds = span['bytes']
    require(type(span['text']) is str and type(span['utf16']) is list and
            len(span['utf16']) == 2 and all(type(v) is int for v in span['utf16']),
            'Rust UTF-16 extent schema')
    require(type(bounds) is list and len(bounds) == 2 and all(type(v) is int for v in bounds)
            and 0 <= bounds[0] <= bounds[1] <= len(source.encode()), 'Rust byte extent schema')
    raw = source.encode()
    prefix, text = raw[:bounds[0]].decode(), raw[bounds[0]:bounds[1]].decode()
    require(text == span['text'] and span['utf16'] == [len(units(prefix)), len(units(prefix + text))],
            'Rust source/UTF-16 mismatch')
    return span


def native_records(case):
    keys(case, {'id', 'source', 'tree', 'lexer_errors', 'parser_errors'}, 'native case')
    source, tree = case['source'], case['tree']
    keys(tree, {'root', 'objects', 'cst'}, 'native tree')
    objects, cst = unique(tree['objects'], 'native objects'), unique(tree['cst'], 'native CST')

    def encoded(value):
        if value is None or type(value) in [str, bool, int, float]:
            return
        require(type(value) is dict, 'native encoded value schema')
        if '$object' in value or '$cst' in value:
            tag, table = ('$object', objects) if '$object' in value else ('$cst', cst)
            keys(value, {tag}, 'native record reference')
            require(type(value[tag]) is str and value[tag] in table, 'native dangling record reference')
            return
        kind = value.get('kind')
        if kind == 'undefined':
            keys(value, {'kind'}, 'native undefined')
        elif kind == 'number':
            keys(value, {'kind', 'bits'}, 'native number')
            require(type(value['bits']) is str and re.fullmatch('[0-9a-f]{16}', value['bits']),
                    'native number bits')
        elif kind == 'grammar_context_object':
            keys(value, {'kind', 'property_keys'}, 'native shallow grammar context')
            strings(value['property_keys'], 'native grammar context keys')
        elif kind == 'grammar_context':
            keys(value, {'kind', 'property_keys', 'properties'}, 'native grammar context')
            for child in props(value).values():
                encoded(child)
        elif kind == 'cst_children':
            keys(value, {'kind', 'property_keys', 'items', 'parent'}, 'native CST children')
            require(type(value['items']) is list, 'native CST child items')
            require(value['property_keys'] == [str(i) for i in range(len(value['items']))] +
                    ['length', 'parent'], 'native CST children inventory')
            for child in value['items']:
                keys(child, {'$cst'}, 'native CST child reference')
                encoded(child)
            encoded(value['parent'])
        else:
            raise ValueError('unknown native encoded value kind: ' + str(kind))

    fields = {}
    line_starts = [0] + [len(units(source[:match.end()]))
                         for match in re.finditer(r'\r\n|\r|\n', source)]

    def range_object(value, expected):
        keys(value, {'$object'}, 'native range reference')
        obj = objects[value['$object']]
        require(obj['kind'] == 'object', 'native range object')
        data = fields[obj['id']]
        keys(data, expected, 'native range fields')
        return data

    def validate_range(span):
        bounds = range_object(span['range'], {'start', 'end'})
        for name, offset in [('start', span['offset']), ('end', span['end'])]:
            location = range_object(bounds[name], {'line', 'character'})
            line = sum(start <= offset for start in line_starts) - 1
            require(all(type(v) is int for v in location.values()) and
                    location == {'line': line, 'character': offset - line_starts[line]},
                    'native CST range/source mismatch')

    for oid, obj in objects.items():
        require(obj.get('kind') in {'ast', 'array', 'reference', 'object'}, 'native object kind')
        expected = {'id', 'kind', 'property_keys', 'properties'}
        if obj['kind'] == 'ast':
            expected.add('node_type')
            require(type(obj['node_type']) is str, 'native AST type')
        if 'regexp' in obj:
            expected.add('regexp')
            keys(obj['regexp'], {'source', 'flags'}, 'native RegExp')
            require(all(type(v) is str for v in obj['regexp'].values()), 'native RegExp strings')
        keys(obj, expected, 'native object')
        fields[oid] = props(obj)
        for row in obj['properties']:
            if 'value' in row:
                encoded(row['value'])
        if obj['kind'] == 'ast':
            require(fields[oid].get('$type') == obj['node_type'], 'native AST type field mismatch')
    for node in cst.values():
        keys(node, {'id', 'property_keys_before_span_read', 'span', 'properties', 'property_keys'},
             'native CST record')
        strings(node['property_keys_before_span_read'], 'native pre-read CST inventory')
        props(node)
        native_span(source, node['span'])
        validate_range(node['span'])
        for row in node['properties']:
            if 'value' in row:
                encoded(row['value'])
    encoded(tree['root'])
    keys(tree['root'], {'$object'}, 'native root reference')
    root = objects[tree['root']['$object']]
    require(root['kind'] == 'ast', 'native root AST required')
    for name in ['lexer_errors', 'parser_errors']:
        require(type(case[name]) is list, 'native diagnostic array')
        for diagnostic in case[name]:
            keys(diagnostic, {'property_keys', 'scalar_fields', 'record'}, 'native diagnostic')
            keys(diagnostic['record'], {'$object'}, 'native diagnostic record')
            encoded(diagnostic['record'])
            record = objects[diagnostic['record']['$object']]
            require(diagnostic['property_keys'] == record['property_keys'] and
                    type(diagnostic['scalar_fields']) is dict, 'native diagnostic inventory')
            scalar_keys = {key for key, value in fields[record['id']].items()
                           if type(value) is not dict or value.get('kind') in {'undefined', 'number'}}
            require(set(diagnostic['scalar_fields']) == scalar_keys, 'native diagnostic scalar keys')
            for key, value in diagnostic['scalar_fields'].items():
                require(key in fields[record['id']] and
                        type(fields[record['id']][key]) is type(value) and
                        fields[record['id']][key] == value, 'native diagnostic scalar/record mismatch')
    return objects, cst, fields, root


def validate_rust_source(case):
    def datum(value):
        if value['lexeme'] is not None:
            rust_span(case['source'], value['lexeme'])
        if value['value']['kind'] == 'array':
            for child in value['value']['items']:
                datum(child)
    if case['outcome']['kind'] == 'arena':
        for node in case['outcome']['nodes']:
            require(node['origin'] is not None, 'Rust finite node source origin unavailable')
            rust_span(case['source'], node['origin'])
            for field in node['fields'].values():
                datum(field)


def _admit(corpus_raw, native_raw, rust_raw, receipt_raw, constructor_comparator):
    blobs = dict(corpus=corpus_raw, native=native_raw, rust=rust_raw, receipt=receipt_raw)
    require(all(type(raw) is bytes for raw in blobs.values()), 'capture inputs must be bytes')
    require(digest(corpus_raw) in CORPORA, 'pinned exact corpus bytes changed')
    corpus, native, rust, receipt = [strict_loads(raw) for raw in blobs.values()]
    corpus_sha, expected = validate_corpus(corpus)
    validate_provenance(native, corpus_sha, len(expected))
    keys(rust, {'schema', 'scope', 'cases'}, 'Rust capture')
    require(type(rust['schema']) is int and rust['schema'] == 1 and type(rust['scope']) is str,
            'Rust capture schema')
    originals, actual = unique(native['cases'], 'native cases'), unique(rust['cases'], 'Rust cases')
    require(list(expected) == list(originals) == list(actual), 'missing/extra/reordered capture case')
    path = Path(constructor_comparator)
    validator = load_constructor(path)
    binding = validate_receipt(receipt, native, corpus_sha)
    native_tables = {}
    for cid, fixture in expected.items():
        n, r, source = originals[cid], actual[cid], fixture['source']
        keys(n, {'id', 'source', 'tree', 'lexer_errors', 'parser_errors'}, 'native case')
        require(n['source'] == r['source'] == source, 'case/source mismatch: ' + cid)
        validator(r)
        native_tables[cid] = native_records(n)
        validate_rust_source(r)
    return dict(corpus=corpus, native=native, rust=rust, receipt=receipt,
                validator=validator, native_tables=native_tables, corpus_sha256=corpus_sha,
                qualification_binding=binding,
                input_sha256={name: digest(raw) for name, raw in blobs.items()},
                constructor_comparator=dict(path=str(path), sha256=CONSTRUCTOR_SHA256),
                status='ADMITTED_SCHEMA_AND_DECLARATIONS_ONLY', full_parity_claimed=False)


def admit(corpus_raw, native_raw, rust_raw, receipt_raw, constructor_comparator):
    """Return freshly validated documents/tables; not an immutable trust token.

    Callers must readmit changed data. Compare outcomes separately; receipt
    declarations do not cryptographically bind capture bytes to execution.
    """
    try:
        return _admit(corpus_raw, native_raw, rust_raw, receipt_raw, constructor_comparator)
    except (KeyError, TypeError, AttributeError, IndexError) as error:
        raise ValueError('malformed capture shape: ' + str(error)) from error
