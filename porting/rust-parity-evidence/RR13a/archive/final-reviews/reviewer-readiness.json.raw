  "source_correctness_review": {
    "no_blocking_regular_API_defect_found": true,
    "filesystem": "Absolute Linuxx86_64 roots, no parentcomponents/symlinkancestors; openedrootdescriptor dev/inode binds laterpathchecks. Stage create_new and hardlink no-replace avoid overwriting destination; trustedSnapshotIo ordering preserveswrite/file-sync/publish/dir-sync/remove/finalroot-check.",
    "read_admission": "symlink_metadata regular+4MiB before open; LinuxO_NONBLOCK|O_NOFOLLOW; descriptor/path dev/inode/len/mtime/ctime comparison at admission and after bounded read; UTF8 then actualmodel parser. No unbounded special-file read intended.",
    "serialization": "Actual current Document.to_json_bounded first counts4MiB/depth128 and then fallibly reserves exact output; entire literalDocument and stable identity roles preserved; Modelerror on provisional oversize is distinct from load TooLarge.",
    "API_compatibility": "Current from_json/to_json_bounded/elements/projection and owned Editor/Transaction begin/create/type/cancel/commit/undo/redo signatures match consumers. Stable resource/element IDs stay separate; editor rotation and persistence URI filter imports exist unchanged.",
    "failure_semantics": "Io may occur after publication or even after stage removal; error never promises rollback/nonpublication. Finalvisible file is not durability proof. Stages retained where sequence fails before removal; directory replacement refuses oldhandle operations.",
    "ownership_boundary": "API does not establish Unix ownership itself. Trustedcaller keeps ownedparents stable; reviewedruntime must supply canonicalowner0700root. Static/path metadata checks are not hostilewriter locks/openat, arbitrarydevice race safety or powerloss guarantees."
  },
  "findings": [
    {
      "id": "RR13A-CANONICAL-BYTE-ORACLE",
      "disposition": "ADDRESSED",
      "initial_gap": "Roundtrip Document equality and unchanged finalbytes alone could miss noncanonical serializer output.",
      "final_evidence": "a42e3ea... adds exact savedbytes==Document.to_json assertion; no case removed."
