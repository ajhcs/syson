      "group": "regression",
      "expected_result": "PASS without ignore/zero-filter substitution",
      "assertion_contract": "Actual mkfifo path, child validroot open, load refuses, parent confirms FIFO retained and child exact1case success.",
      "claim_limit": "Error class is not asserted here; source independently verifies regular preadmission and nonblocking flags."
    },
    {
      "name": "regular_reopen_preserves_canonical_bytes_and_never_overwrites_a_destination",
