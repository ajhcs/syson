      "claim_limit": "Freshhandle reopen in same process; no processrestart or powerloss evidence."
    },
    {
      "name": "root_and_ancestor_symlinks_and_parent_components_refuse_before_creation",
      "group": "regression",
      "expected_result": "PASS without ignore/zero-filter substitution",
      "assertion_contract": "Actual symlinkroot and ancestor refused; no target child created; parent-component root rejected without intermediate/escape creation.",
      "claim_limit": "Stable ownedparent contract remains; no descriptor-relative openat/hostilewriter defense."
