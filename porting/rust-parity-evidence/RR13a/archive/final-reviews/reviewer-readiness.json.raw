    }
  ],
  "expected_cases": [
    {
      "name": "rr13_open_races::regular_to_fifo_between_admission_and_open_refuses",
      "group": "inline",
      "expected_result": "PASS without ignore/zero-filter substitution",
      "assertion_contract": "Private before-open seam replaces admitted regular inode with FIFO; result must refuse, retained original bytes remain; exact child case must run.",
      "claim_limit": "No arbitrary-device or regular-disk latency guarantee."
    },
    {
      "name": "rr13_open_races::regular_to_symlink_between_admission_and_open_refuses",
      "group": "inline",
      "expected_result": "PASS without ignore/zero-filter substitution",
      "assertion_contract": "Private seam replaces admitted regular inode with symlink; refusal and retained original bytes required; source verifies O_NOFOLLOW plus identity checks.",
      "claim_limit": "Tests refusal/liveness, not an independent syscall-tracing proof that no referent open occurred."
    },
    {
      "name": "rr13_open_races::regular_to_new_inode_between_admission_and_open_refuses",
      "group": "inline",
      "expected_result": "PASS without ignore/zero-filter substitution",
      "assertion_contract": "Private seam replaces admitted inode with a different regular inode. read_regular returns String rather than parsing Document, so nonJSON replacement cannot falsely pass via model rejection.",
      "claim_limit": "Controlled named-path race, not hostile-writer atomicity."
    },
    {
