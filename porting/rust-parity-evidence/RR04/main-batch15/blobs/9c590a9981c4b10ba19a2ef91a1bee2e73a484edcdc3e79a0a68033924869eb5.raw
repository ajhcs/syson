// SPDX-License-Identifier: EPL-2.0
//! Development-only observer for the original RR04 dense provisional export.
//! The allocator and fixture helpers below are copied unchanged from RR04's
//! original regression executable. Unsafe allocator delegation stays in this
//! development executable; no library allocator or production policy changes.
//! Only the common pre/post Document::to_json API is observed. Setup, snapshots,
//! preservation checks and JSON reporting occur outside allocation observation.
//! Live bytes at return include the retained result and do not measure leaks.
//! Requested allocation bytes exclude allocator overhead and are not process RSS.
use serde_json::{Value, json};
use std::{
    alloc::{GlobalAlloc, Layout, System},
    cell::Cell,
    time::Instant,
};
use syson_model::{ContainmentFeature, Document, Editor};

#[derive(Clone, Copy, Default, Debug)]
struct Allocations {
    live: isize,
    peak: isize,
    largest: usize,
}
thread_local! {
    static TRACK: Cell<bool> = const { Cell::new(false) };
    static STATS: Cell<Allocations> = const { Cell::new(Allocations { live: 0, peak: 0, largest: 0 }) };
}
fn record(delta: isize, requested: usize) {
    if TRACK.try_with(Cell::get).unwrap_or(false) {
        let _ = STATS.try_with(|cell| {
            let mut stats = cell.get();
            stats.live += delta;
            stats.peak = stats.peak.max(stats.live);
            stats.largest = stats.largest.max(requested);
            cell.set(stats);
        });
    }
}
struct ObservedAllocator;
// SAFETY: Identical pointers/layouts are delegated to System. Constant TLS
// bookkeeping allocates nothing and does not change memory ownership.
unsafe impl GlobalAlloc for ObservedAllocator {
    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
        let pointer = unsafe { System.alloc(layout) };
        if !pointer.is_null() {
            record(layout.size() as isize, layout.size());
        }
        pointer
    }
    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
        let pointer = unsafe { System.alloc_zeroed(layout) };
        if !pointer.is_null() {
            record(layout.size() as isize, layout.size());
        }
        pointer
    }
    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
        record(-(layout.size() as isize), 0);
        unsafe { System.dealloc(pointer, layout) };
    }
    unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, size: usize) -> *mut u8 {
        let next = unsafe { System.realloc(pointer, layout, size) };
        if !next.is_null() {
            record(size as isize - layout.size() as isize, size);
        }
        next
    }
}
#[global_allocator]
static ALLOCATOR: ObservedAllocator = ObservedAllocator;
fn id(n: u32) -> String {
    format!("a0000000-0000-4000-8000-{n:012x}")
}
fn node(n: u32, class: &str, extra: Value) -> Value {
    let mut data = extra.as_object().unwrap().clone();
    data.insert("elementId".into(), Value::String(id(n)));
    json!({"id":id(n+100),"eClass":format!("sysml:{class}"),"data":data})
}
fn base() -> Document {
    Document::from_json(&json!({"json":{"version":"1.0"},"ns":{"sysml":"http://www.eclipse.org/syson/sysml"},"content":[node(1,"Package",json!({"declaredName":"base"}))]}).to_string()).unwrap()
}

fn main() {
    // Exact original dense fixture: 100,000 nulls beneath 60 opaque array
    // wrappers, attached through the real public transaction API.
    let editor = Editor::new(base());
    let original = editor.document().clone();
    let mut opaque = Value::Array(vec![Value::Null; 100_000]);
    for _ in 0..60 {
        opaque = Value::Array(vec![opaque]);
    }
    let fragment = node(2, "OwningMembership", json!({"opaque":opaque}));
    let mut tx = editor.begin();
    tx.attach_preallocated_subtree(&id(1), ContainmentFeature::OwnedRelationship, fragment)
        .unwrap();
    let input_compact_bytes = serde_json::to_vec(tx.document().value()).unwrap().len();
    assert!(input_compact_bytes < 1_048_576);
    let provisional_before = tx.document().clone();

    // The result remains alive when stats are captured. Timing spans the call
    // and its two nonallocating tracking toggles; setup and reporting are excluded.
    STATS.set(Allocations::default());
    let started = Instant::now();
    TRACK.set(true);
    let result = tx.document().to_json();
    TRACK.set(false);
    let elapsed = started.elapsed();
    let stats = STATS.get();

    let editor_preserved = editor.document() == &original;
    let provisional_preserved = tx.document() == &provisional_before;
    let (result_kind, output_len, error) = match &result {
        Ok(output) => ("ok", Some(output.len()), None),
        Err(error) => ("error", None, Some(error.to_string())),
    };
    tx.cancel();
    let editor_preserved_after_cancel = editor.document() == &original;
    println!(
        "{}",
        json!({
            "schema": 1,
            "fixture": "rr04_original_100000_nulls_60_opaque_arrays_public_attachment",
            "api": "Document::to_json",
            "input_compact_bytes": input_compact_bytes,
            "result_kind": result_kind,
            "output_len": output_len,
            "error": error,
            "largest_request_bytes": stats.largest,
            "peak_live_bytes": stats.peak,
            "live_at_return_bytes": stats.live,
            "time_us": elapsed.as_micros(),
            "editor_preserved": editor_preserved,
            "provisional_preserved": provisional_preserved,
            "editor_preserved_after_cancel": editor_preserved_after_cancel,
            "allocation_scope": "actual_to_json_only_result_retained_at_capture",
            "live_at_return_meaning": "retained_result_included_not_leak_detection",
            "allocation_metric": "requested_bytes_not_allocator_overhead_or_rss",
            "rss_bytes": null
        })
    );
    // Drop the successful String or refusal only after reporting; its lifetime
    // explains live_at_return_bytes, independently of later cleanup.
    drop(result);
}
