b=Path(__file__).parent;o=b/'rr08b-f11-api-profiles-01';o.mkdir();(o/'tmp').mkdir();w=Path('/workspace/worktrees/builderbob/syson/batch21-rr08b');c=o/'consumer';c.mkdir();manifest=c/'Cargo.toml';manifest.write_text(f'''[package]
