from pathlib import Path
import fcntl, hashlib, json, os, signal, statistics, subprocess, time
b = Path(__file__).parent
o = b / 'u10b-profile-01'
o.mkdir()
(o / 'tmp').mkdir()
w = Path('/workspace/worktrees/builderbob/syson/batch23-layout-placement')
source = Path('/workspace/worktrees/builderbob/syson/batch23-placement-profile/porting/rust-parity-evidence/C09/batch23-placement-profile/u10b_profile.rs')
tool = Path('/workspace/cache/builderbob/global-tools/rustup/toolchains/1.99.1-x86_64-unknown-linux-gnu/bin')
cargo = tool / 'cargo'
files = {Path(__file__), source, cargo, tool / 'rustc', tool / 'rustfmt', tool / 'clippy-driver'}
files.update(p for p in (w / 'rust/crates/syson-layout').rglob('*') if p.is_file())
sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
snapshot = lambda: {str(p): sha(p) for p in sorted(files)}
record = {'status': 'RUNNING', 'scope': 'Fixed U10b qualification cases only; not a reusable sampler or runtime helper.', 'inputs_before': snapshot(), 'commands': []}
(o / 'executed-runner.py').write_bytes(Path(__file__).read_bytes())
lock = Path('/workspace/build/builderbob/syson-audit-20261026/build/compiler.lock').open()
fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
env = {'PATH': str(tool) + ':/usr/bin:/bin', 'HOME': os.environ['HOME'], 'LANG': 'C.UTF-8',
       'CARGO_HOME': '/workspace/cache/builderbob/global-tools/cargo',
       'RUSTUP_HOME': '/workspace/cache/builderbob/global-tools/rustup',
       'RUSTUP_TOOLCHAIN': '1.99.1-x86_64-unknown-linux-gnu', 'CARGO_BUILD_JOBS': '1',
       'RUST_TEST_THREADS': '1', 'CARGO_INCREMENTAL': '0',
       'CARGO_TARGET_DIR': str(b / 'target-u10b-profile'), 'TMPDIR': str(o / 'tmp')}
child = None
samples = []
summary = []
def interrupted(signum, frame):
    raise RuntimeError('Interrupted ' + str(signum))
signal.signal(signal.SIGTERM, interrupted)
def run(label, argv, expected=0):
    global child
    argv = list(map(str, argv))
    started = time.monotonic()
    child = subprocess.Popen(argv, cwd=o, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    try:
        out, err = child.communicate(timeout=180)
        timed_out = False
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        out, err = child.communicate(timeout=10)
        timed_out = True
    (o / (label + '-stdout.json')).write_bytes(out)
    (o / (label + '-stderr.txt')).write_bytes(err)
    row = {'label': label, 'argv': argv, 'exit': child.returncode, 'expected_exit': expected,
           'timed_out': timed_out, 'wall_seconds': time.monotonic() - started}
    record['commands'].append(row)
    child = None
    if row['exit'] != expected or timed_out:
        raise RuntimeError('Preserve failed ' + label)
    return out
try:
    manifest = o / 'Cargo.toml'
    quoted = lambda path: json.dumps(str(path))
    manifest.write_text('[package]\nname="u10b-placement-qualification"\nversion="0.0.0"\nedition="2024"\n[dependencies]\nserde_json="=1.0.151"\nsyson-layout={path=' + quoted(w / 'rust/crates/syson-layout') + '}\n[[bin]]\nname="u10b-profile"\npath=' + quoted(source) + '\n[workspace]\n')
    run('lock', [cargo, 'generate-lockfile', '--offline', '--manifest-path', manifest])
    files.update([manifest, o / 'Cargo.lock'])
    record['prepared_inputs_before'] = snapshot()
    run('format', [tool / 'rustfmt', '--edition', '2024', '--check', source])
    run('clippy', [cargo, 'clippy', '--release', '--offline', '--locked', '--jobs', '1', '--manifest-path', manifest, '--all-targets', '--', '-D', 'warnings'])
    run('build', [cargo, 'build', '--release', '--offline', '--locked', '--jobs', '1', '--manifest-path', manifest])
    executable = b / 'target-u10b-profile/release/u10b-profile'
    record['executable_sha256'] = sha(executable)
    for nodes in [64, 128, 256, 1024]:
        for density in [1, 2]:
            label = str(nodes) + '-' + str(density)
            measured = []
            for repetition in range(9):
                data = json.loads(run(label + '-' + str(repetition), [executable, nodes, density]))
                if data['expected_outcome'] is not True or data['timed_api'] != 'layout':
                    raise RuntimeError('Unexpected default workload ' + label)
                samples.append({'workload': label, 'phase': 'warmup' if repetition < 2 else 'measured', 'repetition': repetition, 'data': data})
                if repetition >= 2:
                    measured.append(data)
            values = [d['api_ns'] / 1e6 for d in measured]
            statuses = sorted({d['status'] for d in measured})
            if len(statuses) != 1:
                raise RuntimeError('Inconsistent workload status ' + label)
            summary.append({'workload': label, 'status': statuses[0], 'metric_scope': 'refusal latency' if statuses[0] == 'EXPECTED_DEFAULT_WORK_REFUSAL' else 'layout API latency',
                            'measured': 7, 'api_ms': {'min': min(values), 'median': statistics.median(values), 'max': max(values)},
                            'requested_bytes': sorted({d['allocations']['requested_bytes'] for d in measured}),
                            'phase_peak_live_bytes': sorted({d['allocations']['phase_peak_live_bytes'] for d in measured}),
                            'phase_peak_above_initial_live_bytes': sorted({d['allocations']['phase_peak_above_initial_live'] for d in measured}),
                            'process_hwm_kib': {'min': min(d['process_peak_rss_kib'] for d in measured), 'max': max(d['process_peak_rss_kib'] for d in measured)}})
            print(json.dumps(summary[-1]), flush=True)
    for density in [1, 2]:
        data = json.loads(run('cancel-before-' + str(density), [executable, 64, density, '--cancel-before']))
        if data['status'] != 'EXPECTED_CANCELLED_BEFORE_ADMISSION' or data['allocations']['requested_bytes'] != 0:
            raise RuntimeError('Precancellation mismatch')
    controls = [('--continuation', 'EXPECTED_CONTINUED_LAYOUT_MATCHES_WRAPPER'),
                ('--budget-continuation', 'EXPECTED_CONTINUED_WORK_REFUSAL'),
                ('--cancel-between', 'EXPECTED_CANCELLED_BEFORE_PLACEMENT_ALLOCATION')]
    for flag, expected in controls:
        data = json.loads(run(flag.removeprefix('--'), [executable, 64, 1, flag]))
        if data['status'] != expected or data['timed_api'] != 'place_after_admission':
            raise RuntimeError('Direct continuation mismatch ' + flag)
    invalid = [[63, 1], [64, 3], [64, 1, '--unknown'], [128, 1, '--continuation'], [64, 1, '--continuation', '--cancel-between']]
    for index, args in enumerate(invalid):
        data = json.loads(run('invalid-cli-' + str(index), [executable, *args], 2))
        if data['status'] != 'INVALID_ARGUMENTS':
            raise RuntimeError('Invalid CLI mismatch')
    record.update(status='PASS_72_LAYOUT_OR_REFUSAL_OBSERVATIONS_5_REAL_CONTINUATION_CANCEL_CONTROLS_5_CLI_REFUSALS', p95_claimed=False)
except BaseException as error:
    record.update(status='FAIL_TERMINAL', error=repr(error))
    raise
finally:
    if child is not None and child.poll() is None:
        os.killpg(child.pid, signal.SIGKILL)
        child.communicate(timeout=10)
    (o / 'samples.json').write_text(json.dumps(samples, indent=2) + '\n')
    (o / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    record['inputs_after'] = snapshot()
    record['source_unchanged'] = all(record['inputs_after'].get(k) == v for k, v in record['inputs_before'].items())
    (o / 'receipt.json').write_text(json.dumps(record, indent=2) + '\n')
    if not record['source_unchanged']:
        raise RuntimeError('Source drift')
