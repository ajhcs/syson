finally:
 r['source_after']=snap();r['source_unchanged']=all(r['source_after'].get(k)==v for k,v in r['source_before'].items());(o/'receipt.json').write_text(json.dumps(r,indent=2)+'\n')
 if not r['source_unchanged']:raise RuntimeError('Profile source drift')
