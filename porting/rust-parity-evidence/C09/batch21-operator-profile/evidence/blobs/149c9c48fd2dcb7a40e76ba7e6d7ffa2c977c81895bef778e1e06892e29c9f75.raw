from pathlib import Path
import fcntl,hashlib,json,os,shutil,signal,statistics,subprocess,time
b=Path(__file__).parent;o=b/'operator-api-profile-01';o.mkdir();(o/'tmp').mkdir();w=Path('/workspace/worktrees/builderbob/syson/batch21-operator-landing');source=b/'operator_profile.rs';sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();files={source,b/'operator-profile-notes.md',Path(__file__)}
for name in ['syson-ast-adapter','syson-ast','syson-ast-values','syson-reflection','syson-ast-dispatch']:files.update(p for p in (w/'rust/crates'/name).rglob('*') if p.is_file())
snap=lambda:{str(p):sha(p) for p in sorted(files)};r={'status':'RUNNING','source_before':snap(),'commands':[],'samples':[],'scope':'Instrumented Rust synthetic F12 API baseline; original candidate before RR08 repair. No native/UI/parser/capacity acceptance.'};lock=open('/workspace/build/builderbob/syson-audit-20261026/build/compiler.lock');fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);(o/'executed-runner.py').write_bytes(Path(__file__).read_bytes());env=dict(os.environ,CARGO_BUILD_JOBS='1',RUST_TEST_THREADS='1',CARGO_INCREMENTAL='0',CARGO_TARGET_DIR='/workspace/build/builderbob/syson-batch15-20261029/target',TMPDIR=str(o/'tmp'))
def run(label,argv,expected=0):
 start=time.monotonic();child=subprocess.Popen(list(map(str,argv)),cwd=o,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
 try:stdout,stderr=child.communicate(timeout=180);timed=False
 except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);stdout,stderr=child.communicate(timeout=10);timed=True
 (o/(label+'-stdout.txt')).write_bytes(stdout);(o/(label+'-stderr.txt')).write_bytes(stderr);row={'label':label,'argv':list(map(str,argv)),'pid':child.pid,'exit':child.returncode,'timed_out':timed,'wall_seconds':time.monotonic()-start};r['commands'].append(row)
 if child.returncode!=expected or timed:raise RuntimeError('Preserve unexpected '+label+': '+str(row))
 return stdout
try:
 manifest=o/'Cargo.toml';q=lambda p:json.dumps(str(p));manifest.write_text('[package]\nname="operator-profiler"\nversion="0.0.0"\nedition="2024"\n[dependencies]\nserde_json="=1.0.151"\nsyson-ast={path='+q(w/'rust/crates/syson-ast')+'}\nsyson-ast-adapter={path='+q(w/'rust/crates/syson-ast-adapter')+'}\n[[bin]]\nname="operator-profile"\npath='+q(source)+'\n[workspace]\n');run('rustc-version',['rustc','-vV']);run('cargo-version',['cargo','-V']);run('lock',['cargo','generate-lockfile','--offline','--manifest-path',manifest]);files.update([manifest,o/'Cargo.lock']);r['prepared_source_before']=snap();run('build',['cargo','build','--release','--offline','--locked','--jobs','1','--manifest-path',manifest]);binary=o/'operator-profile';shutil.copy2(Path(env['CARGO_TARGET_DIR'])/'release/operator-profile',binary);r['binary_sha256']=sha(binary)
 for n in [100,1000,5000]:
  for i in range(9):
   label=f'n{n}-{i}';d=json.loads(run(label,[binary,str(n)]));assert d['status']=='COMPLETE_SYNTHETIC_API_BASELINE' and d['inserted_reports']==n and d['actual_final_nodes']==1+4*n;row={'n':n,'phase':'warmup' if i<2 else 'measured','index':i,'observation':d};r['samples'].append(row);(o/'receipt.json').write_text(json.dumps(r,indent=2)+'\n');print(json.dumps({'n':n,'phase':row['phase'],'index':i,'apply_ms':d['apply_ns']/1e6,'requested_bytes':d['apply_allocations']['requested_bytes'],'peak_above_initial_live':d['apply_allocations']['phase_peak_above_initial_live'],'RSS_kib':d['process_peak_rss_kib']}),flush=True)
 cancel=json.loads(run('cancel-before-apply',[binary,'100','--cancel-before-apply'],1));assert cancel['inserted_reports']==0 and 'Cancelled' in cancel['apply_failure'] and 'Cancelled' in cancel['finish_failure'];r['cancellation_control']=cancel;r['ranges']={}
 for n in [100,1000,5000]:
  xs=[x['observation']['apply_ns']/1e6 for x in r['samples'] if x['n']==n and x['phase']=='measured'];r['ranges'][str(n)]={'min_ms':min(xs),'median_ms':statistics.median(xs),'max_ms':max(xs)}
 r['status']='PASS_INSTRUMENTED_API_BASELINE_AND_TYPED_CANCELLATION;RR08_PERFORMANCE_AND_PARITY_OPEN'
