(o/'receipt.json').write_text(json.dumps({'status':'BOUND_PRELIMINARY_INSPECTION_ONLY;NOT_PARITY_ACCEPTANCE','runs':rows},indent=2)+'\n');print(json.dumps([{k:x[k] for k in ['finite_cases','cache_differences','origin_differences']} for x in rows]))
