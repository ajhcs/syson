//! Comment-heavy finite Adapter::construct API timing; no UI/native/capacity claim.
//! Allocator/counters/rss body is copied unchanged from operator_profile.rs,
//! SHA-256 7b3a29d8b66289fc7f68dabdc8b8c3477a5256ac425b53dd99db0f2cef68e6a1,
//! at /workspace/build/builderbob/syson-batch21-20261029/operator_profile.rs.
use std::alloc::{GlobalAlloc, Layout, System};
use std::sync::{
    Arc,
    atomic::{AtomicBool, AtomicU64, Ordering::SeqCst},
};
use std::time::Instant;
use syson_ast_adapter::{Adapter, Error, Limits};

struct Allocator;
static REQUESTS: AtomicU64 = AtomicU64::new(0);
static REQUESTED: AtomicU64 = AtomicU64::new(0);
static DEALLOCS: AtomicU64 = AtomicU64::new(0);
static FREED: AtomicU64 = AtomicU64::new(0);
static LIVE: AtomicU64 = AtomicU64::new(0);
static PEAK: AtomicU64 = AtomicU64::new(0);
static PHASE_PEAK: AtomicU64 = AtomicU64::new(0);

fn added(size: usize) {
    let live = LIVE.fetch_add(size as u64, SeqCst) + size as u64;
    PEAK.fetch_max(live, SeqCst);
    PHASE_PEAK.fetch_max(live, SeqCst);
}
fn removed(size: usize) {
    FREED.fetch_add(size as u64, SeqCst);
    DEALLOCS.fetch_add(1, SeqCst);
    LIVE.fetch_sub(size as u64, SeqCst);
}
unsafe impl GlobalAlloc for Allocator {
    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
        REQUESTS.fetch_add(1, SeqCst);
        REQUESTED.fetch_add(layout.size() as u64, SeqCst);
        let result = unsafe { System.alloc(layout) };
        if !result.is_null() {
            added(layout.size());
        }
        result
    }
    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
        unsafe { System.dealloc(ptr, layout) };
        removed(layout.size());
    }
    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
        REQUESTS.fetch_add(1, SeqCst);
        REQUESTED.fetch_add(size as u64, SeqCst);
        let result = unsafe { System.realloc(ptr, layout, size) };
        if !result.is_null() {
            removed(layout.size());
            added(size);
        }
        result
    }
}
#[global_allocator]
static ALLOCATOR: Allocator = Allocator;

#[derive(Clone, Copy)]
struct Counters {
    requests: u64,
    requested: u64,
    deallocs: u64,
    freed: u64,
    live: u64,
    peak: u64,
}
fn counters() -> Counters {
    Counters {
        requests: REQUESTS.load(SeqCst),
        requested: REQUESTED.load(SeqCst),
        deallocs: DEALLOCS.load(SeqCst),
        freed: FREED.load(SeqCst),
        live: LIVE.load(SeqCst),
        peak: PEAK.load(SeqCst),
    }
}
fn delta(a: Counters, b: Counters, phase_peak: u64) -> serde_json::Value {
    serde_json::json!({"allocation_requests": b.requests-a.requests,
        "requested_bytes": b.requested-a.requested, "deallocation_events": b.deallocs-a.deallocs,
        "freed_bytes": b.freed-a.freed, "live_bytes_before": a.live, "live_bytes_after": b.live,
        "global_peak_before": a.peak, "global_peak_after": b.peak,
        "phase_peak_live_bytes": phase_peak,
        "phase_peak_above_initial_live": phase_peak.saturating_sub(a.live)})
}
fn rss_kib() -> Option<u64> {
    std::fs::read_to_string("/proc/self/status")
        .ok()?
        .lines()
        .find(|line| line.starts_with("VmHWM:"))?
        .split_whitespace()
        .nth(1)?
        .parse()
        .ok()
}
fn run(bytes: usize, cancel_before: bool) -> Result<serde_json::Value, String> {
    let adapter = Adapter::pinned().map_err(|e| format!("adapter setup: {e:?}"))?;
    let limits = Limits::default();
    if limits.source_bytes != 65_536 || limits.tokens != 8192 || limits.declarations != 256
        || limits.depth != 32 || limits.kernel.max_nodes != 100_000
        || limits.kernel.max_frames != 1024 || limits.kernel.max_work != 10_000_000
    {
        return Err("default limits changed; review the workload before execution".into());
    }
    let suffix = "\npackage P;";
    let mut source = String::with_capacity(bytes);
    source.push_str("//");
    source.extend(std::iter::repeat_n('x', bytes - 2 - suffix.len()));
    source.push_str(suffix);
    if source.len() != bytes {
        return Err("source construction did not retain the exact byte count".into());
    }
    let cancellation = Arc::new(AtomicBool::new(cancel_before));
    let call_cancel = cancellation.clone();
    // Source, metadata, default limits and cancellation setup precede the timer.
    let before = counters();
    PHASE_PEAK.store(before.live, SeqCst);
    let started = Instant::now();
    let outcome = adapter.construct(&source, limits, call_cancel);
    let api_ns = started.elapsed().as_nanos();
    let after = counters();
    let phase_peak = PHASE_PEAK.load(SeqCst);
    // Counters precede /proc allocations. VmHWM includes setup/earlier activity.
    // Both observations precede subsequent error formatting and JSON/reporting.
    let process_peak_rss_kib = rss_kib();
    let actual_nodes = outcome.as_ref().ok().map(|arena| arena.nodes().len());
    let (status, expected) = match outcome.as_ref() {
        Ok(_) if !cancel_before && bytes <= limits.source_bytes && actual_nodes == Some(3) =>
            ("COMPLETE_COMMENT_HEAVY_CONSTRUCT", true),
        Err(Error::Cancelled) if cancel_before => ("EXPECTED_CANCELLED", true),
        Err(Error::Limit) if !cancel_before && bytes > limits.source_bytes =>
            ("EXPECTED_SOURCE_LIMIT", true),
        _ => ("UNEXPECTED_OUTCOME", false),
    };
    // Keep the actual immutable arena alive through both counter and RSS reads.
    std::hint::black_box(&outcome);
    Ok(serde_json::json!({
        "status": status, "expected_outcome": expected, "source_bytes": source.len(),
        "source_recipe": "ASCII // + x repeated (bytes - 13) + LF + package P;",
        "actual_nodes": actual_nodes, "api_ns": api_ns,
        "cancel_before": cancel_before,
        "error": outcome.as_ref().err().map(|error| format!("{error:?}")),
        "allocations": delta(before, after, phase_peak),
        "process_peak_rss_kib": process_peak_rss_kib,
        "limits": {"source_bytes": limits.source_bytes, "tokens": limits.tokens,
            "declarations": limits.declarations, "depth": limits.depth,
            "kernel": {"max_nodes": limits.kernel.max_nodes,
                "max_frames": limits.kernel.max_frames, "max_work": limits.kernel.max_work}},
        "scope": "One fresh process; only actual Adapter::construct timed. No UI/native/full-parser/capacity acceptance or interior cancellation claim.",
        "accounting": "Copied SeqCst counting System allocator: successful realloc frees old logical storage and adds new; requests include failures. Phase peak resets to initial live. Requested traffic/live increment/absolute peak differ from whole-process VmHWM, read after construct before subsequent JSON/report formatting. Setup and /proc/report allocations are excluded from API counters."
    }))
}
fn main() {
    let args: Vec<String> = std::env::args().collect();
    let bytes = args.get(1).and_then(|s| s.parse::<usize>().ok());
    let cancel = args.get(2).map(String::as_str) == Some("--cancel-before");
    if !(2..=3).contains(&args.len()) || (args.len() == 3 && !cancel)
        || !bytes.is_some_and(|n| [64, 8192, 65_536, 65_537].contains(&n))
    {
        eprintln!("usage: p01-profile BYTES(64|8192|65536|65537) [--cancel-before]");
        std::process::exit(2);
    }
    match run(bytes.unwrap(), cancel) {
        Ok(value) => {
            let expected = value["expected_outcome"] == true;
            println!("{value}");
            if !expected {
                std::process::exit(1);
            }
        }
        Err(error) => {
            println!("{}", serde_json::json!({"status":"SETUP_FAILURE", "error":error}));
            std::process::exit(1);
        }
    }
}
