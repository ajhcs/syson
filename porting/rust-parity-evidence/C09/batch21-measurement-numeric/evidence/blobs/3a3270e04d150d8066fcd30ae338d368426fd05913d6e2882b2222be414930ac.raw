  if mode=='term':
   needle="run('cargo-version', [cargo, '--version', '--verbose'])";assert raw.count(needle)==1;raw=raw.replace(needle,"run('wait-probe', ["+repr(shutil.which('python3'))+", '-c', "+repr(helper)+"])")
