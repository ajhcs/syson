  p.write_text(raw);argv=['python3',str(p),'--repo',str(src.parents[3]),'--corpus','/workspace/build/builderbob/syson-batch20-20261029/measurement-cases-v2.json','--out',str(capture),'--target-dir','/workspace/build/builderbob/syson-batch15-20261029/target','--cargo-home','/workspace/cache/builderbob/global-tools/cargo']
  with (case/'stdout.txt').open('wb') as stdout,(case/'stderr.txt').open('wb') as stderr:
   proc=subprocess.Popen(argv,stdout=stdout,stderr=stderr,start_new_session=True);deadline=time.monotonic()+12;owned=None
   while not marker.exists() and proc.poll() is None and time.monotonic()<deadline:time.sleep(.01)
   if mode=='term':
    assert marker.exists();children=Path(f'/proc/{proc.pid}/task/{proc.pid}/children').read_text().split();assert len(children)==1;owned=identity(int(children[0]));os.kill(proc.pid,signal.SIGTERM)
   else:
