from pathlib import Path
import copy,fcntl,hashlib,importlib.util,json,os,subprocess,time
b=Path(__file__).parent;o=b/'operator-report-controls-01';o.mkdir();t=Path('/workspace/worktrees/builderbob/syson/batch21-operator-tools/porting/rust-parity-evidence/C09/batch21-operator-tools');capture=b/'operator-qualification-01';lock=open('/workspace/build/builderbob/syson-audit-20261026/build/compiler.lock');fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
oldpath=b/'operator-tools-before-review/compare_operator.py';newpath=t/'compare_operator.py'
def module(label,path):
 spec=importlib.util.spec_from_file_location(label,path);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);return m
old=module('old_operator_comparator',oldpath);new=module('new_operator_comparator',newpath);corpus=json.loads((t/'operator_corpus.json').read_text());native=json.loads((capture/'native.json').read_text());rust=json.loads((capture/'rust.json').read_text());base_old=old.compare(corpus,native,rust);base_new=new.compare(corpus,native,rust);assert old.exact(base_old,base_new),'baseline changed'
def row(doc,id):return next(x for x in doc['cases'] if x['id']==id)
mutations=[('inserted-flag',lambda d:row(d,'classification-as')['steps'][0]['report'].update(normalized_operands=False)),('unchanged-flag',lambda d:row(d,'operator-absent')['steps'][0]['report'].update(normalized_operands=False)),('fabricated-insert',lambda d:row(d,'repeated-application')['steps'][-1].update(report=dict(row(d,'repeated-application')['steps'][0]['report'],normalized_operands=False)))]
rows=[]
for name,mutate in mutations:
 changed=copy.deepcopy(rust);mutate(changed);(o/(name+'-rust.json')).write_text(json.dumps(changed)+'\n');a=old.compare(corpus,native,changed);z=new.compare(corpus,native,changed);assert old.exact(a,base_old) and not new.exact(z,base_new);rows.append({'case':name,'old_undetected':True,'new_detected':True})
reports=[]
for label,flags in [('normal',[]),('optimized',['-O'])]:
 target=o/(label+'-comparison.json');argv=['python3',*flags,str(newpath),'--corpus',str(t/'operator_corpus.json'),'--native',str(capture/'native.json'),'--rust',str(capture/'rust.json'),'--out',str(target),'--self-test'];r=subprocess.run(argv,capture_output=True,timeout=30);(o/(label+'-stdout.txt')).write_bytes(r.stdout);(o/(label+'-stderr.txt')).write_bytes(r.stderr);assert r.returncode==1,(r.stdout,r.stderr);reports.append(json.loads(target.read_text()))
 bad=copy.deepcopy(rust);bad['cases'][0]['before']['nodes'][0].pop('container');badpath=o/(label+'-invalid.json');badpath.write_text(json.dumps(bad));argv[argv.index('--rust')+1]=str(badpath);argv[argv.index('--out')+1]=str(o/(label+'-invalid-report.json'));r=subprocess.run(argv,capture_output=True,timeout=30);(o/(label+'-invalid-stdout.txt')).write_bytes(r.stdout);(o/(label+'-invalid-stderr.txt')).write_bytes(r.stderr);assert r.returncode==2
assert reports[0]==reports[1];d=reports[0];result={'status':'PASS_3_GENUINE_OLD_BLINDSPOTS_FIXED_AND_STRICT_NORMAL_OPTIMIZED_REPORTS','cases':42,'differences':len(d['differences']),'open_items':len(d['open_items']),'controls':len(d['controls']),'genuine_old_new':rows,'baseline_semantic_results_unchanged':True,'source':{str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in [oldpath,newpath,*[t/name for name in ['operator_dump.rs','operator_oracle.cjs','operator_corpus.json']],capture/'native.json',capture/'rust.json']},'reuse':'Actual native/Rust captures from qualification01; observer/oracle/corpus bytes unchanged, only comparator/README repaired.'};(o/'receipt.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({k:v for k,v in result.items() if k not in ['source','genuine_old_new']}))
