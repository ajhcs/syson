[package]
name="batch17-public-consumers"
version="0.0.0"
edition="2024"
[workspace]
[[bin]]
name="reflection-dump"
path="reflection_dump.rs"
[[bin]]
name="reference-probe"
path="reference_probe.rs"
[dependencies]
serde_json="=1.0.151"
syson-references={path="/workspace/worktrees/builderbob/syson/batch17-references/rust/crates/syson-references"}
syson-model={path="/workspace/worktrees/builderbob/syson/batch17-references/rust/crates/syson-model"}
syson-metamodel={path="/workspace/worktrees/builderbob/syson/batch17-references/rust/crates/syson-metamodel"}
syson-reflection={path="/workspace/worktrees/builderbob/syson/batch17-reflection/rust/crates/syson-reflection"}
