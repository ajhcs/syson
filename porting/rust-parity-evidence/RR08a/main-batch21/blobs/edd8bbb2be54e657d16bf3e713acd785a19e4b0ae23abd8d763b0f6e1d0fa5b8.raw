#[test]
fn known_kind_copy_refuses_before_allocation() {
 let kind="K".repeat(65_536); let mut reflection=Reflection::default();
 reflection.declare(kind.clone(),vec![]).unwrap();
 let mut b=Builder::new(reflection,Limits {max_work:32,..Limits::default()},Arc::new(AtomicBool::new(false))).unwrap();
