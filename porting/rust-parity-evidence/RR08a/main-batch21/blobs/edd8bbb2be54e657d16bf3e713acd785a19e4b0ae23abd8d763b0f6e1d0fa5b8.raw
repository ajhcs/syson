}
#[test]
fn unknown_type_payload_refuses_before_allocation() {
 let kind="K".repeat(65_536); let mut b=builder(Limits {max_work:32,..Limits::default()});
 REQUESTS.set(Requests::default()); TRACK.set(true); let result=b.allocate(Some(&kind),None); TRACK.set(false);
