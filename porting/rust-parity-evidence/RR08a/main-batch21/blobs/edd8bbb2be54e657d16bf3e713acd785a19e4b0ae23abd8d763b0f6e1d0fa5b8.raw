#[test]
fn cancellation_after_reservation_refuses_before_id_spend() {
 let kind="K".repeat(65_536); let mut reflection=Reflection::default();
 reflection.declare(kind.clone(),vec![]).unwrap();reflection.declare("Element".into(),vec![]).unwrap();
 let flag=Arc::new(AtomicBool::new(false));let mut b=Builder::new(reflection,Limits::default(),flag.clone()).unwrap();
 let (result,stats)=cancellation_window(&flag,||b.allocate(Some(&kind),None).map(|_|()));
