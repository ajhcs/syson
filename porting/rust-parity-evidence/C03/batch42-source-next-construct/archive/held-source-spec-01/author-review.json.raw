  "fixed_scope": {
    "normative60": "Exact pinned old48 plus12explicit source-next additions including constructor/test/doc; no caller required-set.",
    "old_snapshot1167_and_progress318": "Pinned prior snapshot and register bytes, exact old names; old required/progress coverage retained with declared current normative/generated-output slots replaced and all other old hashes checked.",
    "new_progress": "Exactly17 compact proof rows below, four pinned unchanged fixtures and three prior roles; no caller progress option.",
    "default_policy": "Unchanged actual G PENDING_ROOT_FREEZE; failure precedes context/parse/copy/output.",
    "current_files": "Exact bytes map is an explicit staged claim; None uses canonical fixed current-root stat/bounded reads with one cache. Unknown/missing/reserved names refuse.",
    "prior_register_once": "Prior-register parameter occupies one fixed prior cache/progress role; live remaining-work/units.json omitted from input map and new register added only as output hash."
  },
  "implementation": [
    "Reuse whole-pinned actual P353/D291/G349 without global overrides or calling fixed .10 contract_lock/snapshot. Actual D/G normalized whole body pins are checked; constructor/D/G supplied bytes equal actual canonical source. Caller must whole-pin qualified modules before loading, as the unit bootstrap does.",
    "G validates actual full797 plan/current source/held semantics and whole .10/.9/.8 restoration; current raw execution byte pin preserves all55history and coordinator attribution.",
    "Every full797 unit record deep-copied with all unknown metadata preserved. Only primary_family, brief, brief_sha256, complete_plan_unit_sha256, feature_acceptance overlays recomputed from actual current input bytes/state. Register top metadata preserved with explicit snapshot/current identity/field coverage/integration updates.",
    "Reader precharges raw bytes and actual logical namehash framing plus fixed output reservation before parsing/copying; default physical mode stats all current files before reading. Perfile8MiB/name4096/map1300 limits are finite fixed guards.",
    "Snapshot output reservation is justified qualified full797 profile: register6MiB, lock256KiB, manifest512KiB. Actual output profile and combined actual serialized bytes are checked before mkdir/write. This reservation is deliberately tighter than an unjustified8MiB register bound; full staged positive must prove viability at runtime.",
    "Live Proposal holds raw cached input context and immutable artifact fingerprint. Reloaded hash-only JSON refuses; artifact/provenance edits refuse. Output is unsigned fresh canonical owned directory only, no install/seal/adoption.",
    "Logical provenance identifies EXPLICIT_SUPPLIED_BYTE_CLAIM, FIXED_HASHED_PRIOR_ARGUMENT, or ACTUAL_CURRENT_ROOT; only actual current-root reads get physical keys. No gzip-origin or synthetic physical assertion. Manifest records actual logical_input_bytes and raw output hashes."
  ],
  "named_test_methods": [
    "test_pending_all_apis_refuse_before_parse_copy_provider_or_output",
    "test_exact60_lock_and_complete_old1167_progress318_preserved",
    "test_all797_fields_and_only_five_overlays_match_actual_bytes",
    "test_full_staged_output_actual_serialization_combined64_and_truthful_origins",
    "test_current_files_are_not_mutated_or_referenced_as_mutable_input_dict",
    "test_prior_rawpins_types_and_oversize_refuse_before_parse",
    "test_all_fixed_required_progress_and_prior_namespace_coverage_refuse",
    "test_proof_fixture_old_progress_and_held_execution_drift_refuse",
    "test_coherent_current_lock_and_full_record_source_corruptions_refuse",
    "test_default_physical_root_refuses_missing_unadopted_roles",
    "test_real64mib_exact_and_one_extra_before_parse_or_copy",
    "test_writer_rejects_hash_only_replay_and_mutated_artifact_before_output",
    "test_writer_existing_symlink_and_escape_refusals_preserve_prior_bytes",
    "test_identity_types_and_reused_snapshot_identity_refuse",
    "test_actual_source_body_binding_refuses_coherently_supplied_changed_bytes",
    "test_canonical_reader_uses_actual_bytes_once_and_early_stat_bound"
  ],
  "named_test_method_count": 16,
  "full_staged_positive": {
    "input_scope": "All current old1167 roles minus replaced live register, fixed60, all318progress, exact17proofs, fourfixtures, current797plan/schema/contract, three newbrief roles and fixed prior args.",
    "new_loader": "Explicit non-code PROPOSED_LOGICAL_ROLE_ONLY marker; no loader implementation invented or executed.",
    "new_briefs": "Three explicitly proposed brief byte claims; actual generator render/physical default positive remain atomic-adoption gates.",
    "expected_checks": "All797 records compared field-by-field to current full plan plus exactly5overlays; all old coverage/progress and55history; unsigned write5+MiBregister, raw hashes, actual combined64MiB serialization and truthful origins.",
    "limits": "No runtime size/PASS is claimed by this source report. Test filesystem temporarily scopes only new C.OUTPUT_ROOT to approved test root; old policies/globals are not changed."
  },
