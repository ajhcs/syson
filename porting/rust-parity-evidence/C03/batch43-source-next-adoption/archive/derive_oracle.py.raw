from pathlib import Path
import hashlib
import json
import os
import sys

ROOT = Path('/workspace/worktrees/builderbob/syson/batch43-source-next-adoption-20261031/porting/rust-parity-plan-20261026')
BUILD = Path('/workspace/build/builderbob/syson-durable-batch43-20261031')
loader = ROOT / 'tools/source_next_splits.py'
if hashlib.sha256(loader.read_bytes()).hexdigest() != '1819a78e4eec01d952b8d211c37fe9cf287e075883a119cac497537da2383c5d':
    raise ValueError('fixed qualified loader source changed')
sys.path.insert(0, str(ROOT / 'tools'))
import source_next_splits as G

P, unused = G.D.provider()
fixture = ROOT / 'composition/source_next_prepare/fixtures'
arguments = [(fixture / name).read_bytes() for name in ['baseline-1.0.10.json.gz', 'baseline-provenance.json']]
arguments += [(ROOT / name).read_bytes() for name in ['lanes/source-next.json',
              'amendments/1.0.11-source-next.md', 'tools/build_plan.py', G.D.OWNER]]
proposal = G.D.derive(*arguments)
if set(proposal['artifacts']) != {'policy.json', 'completion-contract.json',
        'acceptance-packet.schema.json', 'expected-plan.json', 'source-metadata.json'}:
    raise ValueError('fixed complete unsigned artifact set required')
encoded = {name: P.encode(value) for name, value in proposal['artifacts'].items()}
support = {str(path): path.read_bytes() for path in [Path(__file__), loader, Path(G.__file__)]}
manifest = {key: value for key, value in proposal.items() if key != 'artifacts'}
manifest.update(artifacts={name: P.sha(raw) for name, raw in encoded.items()},
                support_sha256={name: P.sha(raw) for name, raw in support.items()})
encoded['manifest.json'] = P.encode(manifest)
support_charge = sum(len(raw) + len(P.encode({name: '0' * 64})) for name, raw in support.items())
if sum(map(len, encoded.values())) + support_charge > len(P.encode(proposal)):
    raise ValueError('writer must fit the already admitted combined derive envelope')
out = Path(sys.argv[1])
if (out.parent != BUILD or out.parent.resolve() != out.parent or out.exists() or
        out.is_symlink() or out.parent.stat().st_uid != os.getuid()):
    raise ValueError('fresh canonical owned oracle directory required')
out.mkdir(mode=0o700)
for name, raw in encoded.items():
    with (out / name).open('xb') as stream:
        stream.write(raw)
print(json.dumps({'status': 'UNSIGNED_ORACLE_ONLY_NOT_GENERATOR_CLI_OR_ADOPTION',
                  'policy_sha256': P.digest(proposal['artifacts']['policy.json']),
                  'files': len(encoded), 'output_bytes': sum(map(len, encoded.values())),
                  'support_charge': support_charge, 'guard_policy': G.POLICY_SHA256}))
