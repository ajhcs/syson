  },
  "named_test_methods": [
    "test_pending_all_new_apis_refuse_before_context_or_copy",
    "test_full_positive_private_views_and_complete_old_metadata",
    "test_default_reader_is_not_a_proposed_lane_adoption",
    "test_variable_generator_requires_matching_supplied_read_claim",
    "test_unknown_versions_and_types_never_open_context",
    "test_seal_policy_inventory_pointer_and_child_coherent_mutations",
    "test_all_old_records_and_current_root_metadata_are_authoritative",
    "test_current_owner_history_holds_and_actual_sources_cannot_drift",
    "test_namespace_collision_and_stale_actual_source_identity_refuse",
    "test_model_preflight_rejects_cycles_subclasses_surrogates_before_serialization",
    "test_single_reader_exact_boundary_and_one_extra_byte"
  ],
  "named_test_method_count": 11,
  "test_controls": [
    "All nine current APIs reject PENDING with Session/deepcopy/json serialization sentinels.",
    "Real full proposal restores all three old complete plans and actual provider identities; all held/execution roles read once per cache.",
    "Positive proposed lane uses the already pinned existing fixture under explicit PROPOSED_LOGICAL_FROM_PINNED_EXISTING_FIXTURE role. Default absent physical lane and explicit missing-reader paths refuse.",
    "Variable generator bytes use matched SYNTHETIC_BYTE_CLAIM callback data; changed bytes update expected C99 binding without executing source.",
    "Coherent normalized child mutation plus freshly scoped policy seal isolates bool/float strict ordinary caps; other seal/inventory/family/pointer/child corruptions refuse.",
    "Old M06a1/unassigned records, root schedules, complete current graphs and each C04-C09 joint closure remain authoritative.",
    "Current owner, six held roles, raw current execution/history, generator absence/size and current source drift refuse.",
    "Fixed-package namespace collision refuses before reads; unreviewed whole source body refuses before load; actual old provider source drift, changed actual guard body and normalized-but-different actual seal/supplied binding all refuse through restored temporary mock reads/module maps.",
    "Cycle/subclass/nonfinite/surrogate/integer/depth/object-bound and alias charging controls run before serialization/copy; exact logical byte/framing quota and one-extra-byte read paths are checked."
  ],
