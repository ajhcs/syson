{"name": "capture-normal", "argv": ["/usr/bin/python3", "-I", "-B", "-c", "from pathlib import Path\nimport json\nimport os\nimport sys\nsys.path.insert(0, sys.argv[1])\nimport derive as N\nsource = Path(sys.argv[1])\nfixture = source / 'fixtures'\nplan = source.parents[1]\narguments = [(fixture / n).read_bytes() for n in ['baseline-1.0.10.json.gz', 'baseline-provenance.json', 'lane.json', 'amendment.md']]\narguments += [(plan / 'tools/build_plan.py').read_bytes(), (plan / 'rereview-batch11-coordinator-ownership.json').read_bytes()]\nproposal = N.derive(*arguments)\nP, _ = N.provider()\nout = Path(sys.argv[2])\nP.require(out.is_absolute() and out.is_relative_to(P.OUTPUT_ROOT) and out.parent.resolve() == out.parent and out.parent.stat().st_uid == os.getuid() and not out.exists() and not out.is_symlink(), 'fresh owned root capture required')\nexpected = {'policy.json', 'completion-contract.json', 'acceptance-packet.schema.json', 'expected-plan.json', 'source-metadata.json'}\nP.require(proposal['status'] == 'UNSEALED_PROPOSAL_ONLY' and set(proposal['artifacts']) == expected, 'exact five unsigned candidate outputs')\nencoded = {name: P.encode(value) for name, value in proposal['artifacts'].items()}\nmanifest = {'status': proposal['status'], 'input_sha256': proposal['input_sha256'], 'artifacts': {name: P.sha(raw) for name, raw in encoded.items()}, 'root_capture_sha256': P.sha(Path(sys.argv[3]).read_bytes())}\nencoded['manifest.json'] = P.encode(manifest)\nP.require(sum(map(len, encoded.values())) <= N.LIMIT, 'combined candidate capture bound')\nout.mkdir(mode=0o700)\nfor name, raw in encoded.items():\n    with (out / name).open('xb') as output:\n        output.write(raw)\nprint(json.dumps({'status': proposal['status'], 'artifacts': manifest['artifacts']}))\n", "/workspace/worktrees/builderbob/syson/batch39-source-next-derive-20261031/porting/rust-parity-plan-20261026/composition/source_next_prepare", "/workspace/build/builderbob/syson-durable-batch39-20261031/candidate-normal-02", "/workspace/build/builderbob/syson-durable-batch39-20261031/capture-program-02.py.raw"], "exit": 0, "wall_seconds": 1.015224008999212, "passed": 0}
