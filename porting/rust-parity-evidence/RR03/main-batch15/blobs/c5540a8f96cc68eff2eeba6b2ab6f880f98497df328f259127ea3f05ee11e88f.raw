def run(argv,cwd,expected=0,timeout=300,stdout_path=None):
 index=len(r['commands']);t=time.monotonic();outstream=stdout_path.open('wb') if stdout_path else subprocess.PIPE
 p=subprocess.Popen(argv,cwd=cwd,env=env,stdout=outstream,stderr=subprocess.PIPE,start_new_session=True)
 try:out,err=p.communicate(timeout=timeout);timed=False
 except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);out,err=p.communicate();timed=True
 if stdout_path:outstream.close();out=b''
 (o/f'{index:02}-stdout.txt').write_bytes(out or b'');(o/f'{index:02}-stderr.txt').write_bytes(err or b'');entry={'argv':argv,'cwd':str(cwd),'exit_code':p.returncode,'expected_exit':expected,'timed_out':timed,'wall_seconds':time.monotonic()-t,'stdout_path':str(stdout_path.relative_to(o)) if stdout_path else f'{index:02}-stdout.txt'};r['commands'].append(entry);(o/'receipt.json').write_text(json.dumps(r,indent=2)+'\n');assert p.returncode==expected and not timed,(argv,p.returncode,err.decode()[-1200:]);return out

def build(manifest,name):
 # Re-link from cached source to bind each executable before the common output path changes.
 data=run(['cargo','build','--offline','--locked','--release','--jobs','1','--message-format=json-render-diagnostics','--manifest-path',str(manifest)],manifest.parent)
 artifacts=[json.loads(line) for line in data.splitlines() if line.startswith(b'{')];executables=[Path(x['executable']) for x in artifacts if x.get('reason')=='compiler-artifact' and x.get('executable') and 'bin' in x.get('target',{}).get('kind',[])]
 assert len(executables)==1,executables;dest=o/name;shutil.copyfile(executables[0],dest);dest.chmod(0o700);r['binaries'][name]={'sha256':sha(dest),'source_manifest':str(manifest),'compiler_artifact':str(executables[0])};return dest

