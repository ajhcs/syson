"""Serve an owned developer probe with explicit inputs and a fresh output path."""
from pathlib import Path
from functools import partial
import argparse, fcntl, hashlib, http.server, json, os, signal, subprocess, threading, time

def require(ok, message):
    if not ok: raise ValueError(message)

parser = argparse.ArgumentParser(description=__doc__)
for name in ('build', 'methods', 'node', 'browser', 'playwright', 'libraries', 'out'):
    parser.add_argument('--' + name, type=Path, required=True)
parser.add_argument('--assets', type=Path, default=Path(__file__).parent)
parser.add_argument('--recovery-only', action='store_true')
args = parser.parse_args()
out = args.out.resolve()
if not out.is_relative_to(Path('/workspace')):
    parser.error('--out must be on the approved /workspace volume')
out.mkdir(); web = out / 'web'; web.mkdir()
tools = Path(__file__).resolve().parent
sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
record = {'status': 'RUNNING', 'scope': 'Developer DOM/WASM fixture only'}
server = thread = lock = child = None
files = []
(out / 'executed-runner.py').write_bytes(Path(__file__).read_bytes())
try:
    build_path = args.build / 'receipt.json'
    build = json.loads(build_path.read_text())
    wasm = args.build / 'measurement_bridge.wasm'
    require(build['status'].startswith('PASS_BUILD_AND_CAPTURE') and build['source_unchanged']
            and build['inputs_before'] == build['inputs_after'], 'build/source disposition not qualified')
    require(sha(wasm) == build['wasm_sha256'], 'WASM bytes differ from build receipt')
    require(all(sha(Path(p)) == h for p, h in build['inputs_after'].items()), 'build input source drift')
    binding_path = args.methods.parent / 'source-binding.json'
    binding = json.loads(binding_path.read_text())
    require(binding['status'] == 'PASS_TYPE_ERASURE_ONLY', 'original-method extraction not qualified')
    require(sha(args.methods) == binding['javascript_sha256'], 'original-method bytes drifted')
    require(binding['inputs_before'] == binding['inputs_after'], 'original source drift during extraction')
    require(all(sha(Path(p)) == h for p, h in binding['inputs_after'].items()), 'original-method source closure drift')
    assets = {name: args.assets / name for name in
              ('measurement_probe.html', 'measurement_fixture.js', 'wasm_client.js')}
    assets.update({'original-methods.js': args.methods, 'measurement_bridge.wasm': wasm})
    for name, source in assets.items():
        (web / ('index.html' if name == 'measurement_probe.html' else name)).write_bytes(source.read_bytes())
    sdk_files = [p for package in (args.playwright, args.playwright.parent / 'playwright-core')
                 for p in package.rglob('*') if p.is_file() and p.suffix in ('.js', '.cjs', '.mjs', '.json')]
    files = sorted(set([*assets.values(), tools / 'run_browser.cjs', Path(__file__),
                        build_path, binding_path, args.node, args.browser, *sdk_files,
                        *[Path(p) for p in build['inputs_after']],
                        *[Path(p) for p in binding['inputs_after']],
                        *[p for p in args.libraries.glob('*.so*') if p.is_file()]]))
    record.update(inputs_before={str(p): sha(p) for p in files},
                  served_assets={name: sha(p) for name, p in assets.items()})
    lock = open('/workspace/build/builderbob/syson-audit-20261026/build/compiler.lock')
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    class Handler(http.server.SimpleHTTPRequestHandler):
        def log_message(self, *unused): pass
        def end_headers(self):
            self.send_header('Cache-Control', 'no-store'); super().end_headers()
    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), partial(Handler, directory=str(web)))
    thread = threading.Thread(target=server.serve_forever, daemon=True); thread.start()
    argv = [str(args.node), str(tools / 'run_browser.cjs'),
            f'http://127.0.0.1:{server.server_port}/', str(out), str(args.browser),
            str(args.playwright), 'recovery' if args.recovery_only else 'full']
    record['argv'] = argv
    start = time.monotonic()
    child = subprocess.Popen(argv, cwd=out, start_new_session=True, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, env=dict(os.environ, TMPDIR=str(out),
                             XDG_CACHE_HOME=str(out / 'cache'), LD_LIBRARY_PATH=str(args.libraries)))
    record['pid'] = child.pid
    try: record['pid_start_ticks'] = Path(f'/proc/{child.pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
    except FileNotFoundError: record['pid_start_ticks'] = None
    try:
        stdout, stderr = child.communicate(timeout=180); timed = False
    except subprocess.TimeoutExpired:
        try: os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        stdout, stderr = child.communicate(); timed = True
    (out / 'stdout.txt').write_bytes(stdout); (out / 'stderr.txt').write_bytes(stderr)
    record.update(exit=child.returncode, timed_out=timed, wall_seconds=time.monotonic() - start,
                  status='PASS_NAMED_DOM_WASM_ONLY' if child.returncode == 0 and not timed else 'FAIL_TERMINAL')
    print(stdout.decode(), flush=True); print(stderr.decode(), flush=True)
except Exception as error:
    record.update(status='FAIL_TERMINAL', error=repr(error))
finally:
    if child is not None and child.poll() is None:
        try: os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        stdout, stderr = child.communicate()
        (out / 'stdout.txt').write_bytes(stdout); (out / 'stderr.txt').write_bytes(stderr)
    if server is not None:
        if thread is not None and thread.is_alive(): server.shutdown()
        server.server_close()
    if thread is not None and thread.ident is not None: thread.join(timeout=5)
    record['server_closed'] = thread is None or not thread.is_alive()
    record['inputs_after'] = {str(p): sha(p) if p.is_file() else None for p in files}
    record['source_unchanged'] = record.get('inputs_before') == record['inputs_after']
    if not record['source_unchanged'] or not record['server_closed']: record['status'] = 'FAIL_TERMINAL'
    (out / 'receipt.json').write_text(json.dumps(record, indent=2) + '\n')
    if lock is not None: lock.close()
raise SystemExit(0 if record['status'] == 'PASS_NAMED_DOM_WASM_ONLY' else 1)
