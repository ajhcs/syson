  row=next(x for x in r['cases'] if x['id']=='04-comment-only-EOF');offset=row['source'].encode().index(b'/*');row['outcome']={'kind':'rust_error','error':'Unsupported { offset: '+str(offset)+' }'}
 elif mutation=='wrong-bundle':n['provenance']['bundle_sha256']='0'*64
 else:
  for packet in [c,n,r]:packet['cases']=packet['cases'][:1]
  n['provenance']['corpus_cases']=1
 for name,obj in [('corpus',c),('native',n),('rust',r)]:
