import copy,hashlib,json,subprocess
b=Path(__file__).parent;o=b/'p01-comparator-blindspots-01';o.mkdir();tool=b/'p01-comparison-01/executed-comparator.py';assert hashlib.sha256(tool.read_bytes()).hexdigest()=='d1da54e74d7e0cc8cee8a749a628e68022cbd96a252738d5929721c7b432b7f3';corpus=json.loads((b/'p01-corpus-v2.json').read_text());native=json.loads((b/'p01-qualification-06/native-comments.json').read_text());rust=json.loads((b/'p01-qualification-06/rust-comments.json').read_text());rows=[]
for mutation in ['Boolean-root','unknown-node','selected-node-origin','deleted-TypeReference','embedded-comment-refusal','wrong-bundle','coherent-truncation']:
