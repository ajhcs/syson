from pathlib import Path
import fcntl, hashlib, json, os, re, signal, subprocess, sys, time
b = Path(__file__).parent
o = b / 'u11a-checks-01'
o.mkdir()
(o / 'tmp').mkdir()
w = Path('/workspace/worktrees/builderbob/syson/batch25-routing-admission')
crate = w / 'rust/crates/syson-routing'
tool = Path('/workspace/cache/builderbob/global-tools/rustup/toolchains/1.99.1-x86_64-unknown-linux-gnu/bin')
cargo = tool / 'cargo'
files = {Path(sys.executable), Path(__file__), cargo, tool / 'rustc', tool / 'rustfmt', tool / 'clippy-driver'}
files.update((f for f in crate.rglob('*') if f.is_file()))
files.update(f for f in (w / 'rust/crates/syson-layout').rglob('*') if f.is_file())
sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
snap = lambda: {str(f): sha(f) for f in sorted(files)}
r = {'status': 'RUNNING', 'scope': 'U11a actual integer routing admission and public layout consumer; resource/search/native/worker/UI/capacity acceptance remains open', 'inputs_before': snap(), 'commands': []}
(o / 'executed-runner.py').write_bytes(Path(__file__).read_bytes())
lock = open('/workspace/build/builderbob/syson-audit-20261026/build/compiler.lock')
fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
env = {
    'HOME': os.environ['HOME'], 'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8',
    'PATH': str(tool) + ':/usr/bin:/bin',
    'CARGO_HOME': '/workspace/cache/builderbob/global-tools/cargo',
    'RUSTUP_HOME': '/workspace/cache/builderbob/global-tools/rustup',
    'RUSTUP_TOOLCHAIN': '1.99.1-x86_64-unknown-linux-gnu',
    'CARGO_BUILD_JOBS': '1', 'RUST_TEST_THREADS': '1', 'CARGO_INCREMENTAL': '0',
    'CARGO_TARGET_DIR': str(b / 'target-u11a-checked-01'),
    'TMPDIR': str(o / 'tmp'),
}
child = None
signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(RuntimeError('SIGTERM')))

def run(label, args):
    global child
    argv = [cargo, *args]
    start = time.monotonic()
    child = subprocess.Popen(list(map(str, argv)), cwd=o, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    try:
        out, err = child.communicate(timeout=180)
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        out, err = child.communicate(timeout=10)
        raise RuntimeError('Timeout ' + label)
    (o / (label + '-stdout.txt')).write_bytes(out)
    (o / (label + '-stderr.txt')).write_bytes(err)
    row = {'label': label, 'argv': list(map(str, argv)), 'exit': child.returncode, 'wall_seconds': time.monotonic() - start, 'test_cases_passed': sum(map(int, re.findall(b'test result: ok\\. (\\d+) passed;', out)))}
    r['commands'].append(row)
    child = None
    print(json.dumps(row), flush=True)
    if row['exit'] != 0:
        raise RuntimeError(label)
    return row
try:
    manifest = crate / 'Cargo.toml'
    run('lock', ['generate-lockfile', '--offline', '--manifest-path', manifest])
    files.add(crate / 'Cargo.lock')
    r['prepared_inputs_before'] = snap()
    run('format', ['fmt', '--manifest-path', manifest, '--', '--check'])
    row = run('tests', ['test', '--offline', '--locked', '--jobs', '1', '--manifest-path', manifest, '--', '--test-threads=1', '--nocapture'])
    if row['test_cases_passed'] != 13:
        raise RuntimeError('Expected13actualcases')
    run('clippy', ['clippy', '--offline', '--locked', '--jobs', '1', '--manifest-path', manifest, '--all-targets', '--', '-D', 'warnings'])
    run('wasm', ['check', '--offline', '--locked', '--jobs', '1', '--manifest-path', manifest, '--target', 'wasm32-unknown-unknown'])
    r['status'] = 'PASS_13_ROUTING_ADMISSION_CASES_FORMAT_CLIPPY_WASM;RESOURCE_SEARCH_NATIVE_UI_GATES_OPEN'
except BaseException as e:
    r.update(status='FAIL_TERMINAL', error=repr(e))
    raise
finally:
    if child is not None and child.poll() is None:
        os.killpg(child.pid, signal.SIGKILL)
        child.communicate(timeout=10)
    try:
        r['inputs_after'] = snap()
        r['source_unchanged'] = (r['inputs_after'] == r.get('prepared_inputs_before', r['inputs_before'])
                                 and all(r['inputs_after'].get(k) == v for k, v in r['inputs_before'].items()))
    except OSError as error:
        r.update(source_unchanged=False, inputs_after_error=repr(error))
    if not r['source_unchanged']:
        r.update(status='FAIL_TERMINAL', error='Selected input drift')
    (o / 'receipt.json').write_text(json.dumps(r, indent=2) + '\n')
    if not r['source_unchanged']:
        raise RuntimeError('Source drift')
