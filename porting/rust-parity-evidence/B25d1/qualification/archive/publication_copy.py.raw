from pathlib import Path, PurePosixPath
import hashlib
import json
import sys

map_path, output = map(Path, sys.argv[1:])
rows = json.loads(map_path.read_bytes())["copy_rows"]
assert output.is_absolute() and output.parent.resolve() == output.parent
assert not output.exists() and not output.is_symlink()
files = {}
for row in rows:
    source = Path(row["source"])
    name = row["destination"]
    relative = PurePosixPath(name)
    assert str(relative) == name and not relative.is_absolute() and ".." not in relative.parts
    assert name not in files and source.is_file() and not source.is_symlink()
    raw = source.read_bytes()
    assert len(raw) == row["bytes"] and hashlib.sha256(raw).hexdigest() == row["sha256"]
    files[name] = raw
files["archive/publication_copy.py.raw"] = Path(__file__).read_bytes()
files["archive/public-packet-copy-map.json"] = map_path.read_bytes()
output.mkdir(mode=0o700)
for name, raw in files.items():
    target = output / name
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open("xb") as stream:
        stream.write(raw)
index = {name: {"bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}
         for name, raw in sorted(files.items())}
encoded = (json.dumps({"schema": "PUBLIC-PACKET-BYTE-INDEX/1", "files": index}, indent=2) + "\n").encode()
with (output / "packet-index.json").open("xb") as stream:
    stream.write(encoded)
print(json.dumps({"files": len(index) + 1, "bytes": sum(map(len, files.values())) + len(encoded)}))
