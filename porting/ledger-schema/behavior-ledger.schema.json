{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "upstream_revision": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "scope": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inventory_closed": {
          "type": "boolean"
        },
        "dependency_closure_closed": {
          "type": "boolean"
        },
        "closure_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "inventory_closed",
        "dependency_closure_closed",
        "closure_evidence"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "upstream_revision",
    "scope",
    "dependencies",
    "behaviors"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajhcs/syson/porting/ledger-schema/behavior-ledger.schema.json",
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "dependency_id",
        "revision",
        "path",
        "sha256",
        "line_start",
        "line_end"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "SYSON-CASE-[0-9]{6}"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "description",
        "fixtures"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[0-9a-f]{40}"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pinned",
            "unresolved"
          ]
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "repository",
        "revision",
        "owner",
        "status",
        "disposition"
      ],
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "SYSON-BEH-[0-9]{6}"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "unassessed",
            "pending",
            "implemented_bounded",
            "blocked",
            "incompatible",
            "unrun",
            "verified"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "result"
          ],
          "additionalProperties": false
        },
        "implementation": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "[0-9a-f]{40}"
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "revision",
            "authors",
            "files"
          ],
          "additionalProperties": false
        },
        "cases": {
          "type": "object",
          "properties": {
            "positive": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/case"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "negative": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/case"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "failure": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/case"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "positive",
            "negative",
            "failure"
          ],
          "additionalProperties": false
        },
        "runs": {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "rust": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "upstream",
            "rust"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "independent": {
              "type": "boolean"
            },
            "disposition": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "changes_requested"
              ]
            },
            "artifact": {
              "$ref": "#/$defs/artifact"
            }
          },
          "required": [
            "reviewer",
            "independent",
            "disposition",
            "artifact"
          ],
          "additionalProperties": false
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "required",
        "status",
        "owner",
        "dependency_ids",
        "source_evidence",
        "expected",
        "implementation",
        "cases",
        "runs",
        "review",
        "disposition"
      ],
      "additionalProperties": false
    },
    "run_report": {
      "type": "object",
      "properties": {
        "behavior_id": {
          "type": "string",
          "pattern": "SYSON-BEH-[0-9]{6}"
        },
        "side": {
          "type": "string",
          "enum": [
            "upstream",
            "rust"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "executed": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "started_at": {
          "type": "string",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
        },
        "finished_at": {
          "type": "string",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
        },
        "exit_code": {
          "type": "integer"
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unrun"
          ]
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "SYSON-CASE-[0-9]{6}"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fixture_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transcript": {
          "$ref": "#/$defs/artifact"
        },
        "harness_revision": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "harness_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "behavior_id",
        "side",
        "revision",
        "executed",
        "command",
        "started_at",
        "finished_at",
        "exit_code",
        "result",
        "case_ids",
        "fixture_hashes",
        "transcript",
        "harness_revision",
        "harness_files"
      ],
      "additionalProperties": false
    },
    "review_report": {
      "type": "object",
      "properties": {
        "behavior_id": {
          "type": "string",
          "pattern": "SYSON-BEH-[0-9]{6}"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "implementation_revision": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "changes_requested"
          ]
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "SYSON-CASE-[0-9]{6}"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "behavior_id",
        "reviewer",
        "independent",
        "implementation_revision",
        "disposition",
        "case_ids",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
