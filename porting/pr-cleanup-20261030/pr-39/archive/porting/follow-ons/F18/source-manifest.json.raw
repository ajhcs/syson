      "blob": "cfc127d98c827400918c6b36b40708d183123426",
      "anchors": [
        {
          "name": "export const getDefaultOrMinWidth",
          "first": 73,
          "last": 75,
          "sha256": "d9bb586fbe7819b4e95adba649626bdd86fea6e0e4c30672c6a6d928468173f6",
          "source": "export const getDefaultOrMinWidth = (minWidth: number | undefined, node: Node<NodeData>): number => {\n  return Math.max(minWidth ?? -Infinity, node.data.defaultWidth ?? defaultWidth);\n};"
        },
        {
          "name": "export const getDefaultOrMinHeight",
          "first": 77,
          "last": 79,
          "sha256": "04e3618e9ea3157fcdc9611545a89105f2d04520d3aa6b1932b4577ff077dd9e",
          "source": "export const getDefaultOrMinHeight = (minHeight: number | undefined, node: Node<NodeData>): number => {\n  return Math.max(minHeight ?? -Infinity, node.data.defaultHeight ?? defaultHeight);\n};"
        },
        {
          "name": "export const getHeaderHeightFootprint",
          "first": 121,
          "last": 138,
          "sha256": "c061b511bcfa5abc8e7b7f4ca5f5885b04ba41766ba0cd150cc2293439cf8b96",
          "source": "export const getHeaderHeightFootprint = (\n  insideLabel: InsideLabel | null,\n  headerPosition: string | null,\n  borderWith: number = 0\n): number => {\n  let headerHeightFootprint = 0;\n  const withHeader: boolean = insideLabel?.isHeader ?? false;\n  const displayHeaderSeparator: boolean = insideLabel?.displayHeaderSeparator ?? false;\n\n  if (withHeader && insideLabel?.headerPosition === headerPosition) {\n    headerHeightFootprint = insideLabel.height;\n    if (displayHeaderSeparator) {\n      headerHeightFootprint += borderWith;\n    }\n  }\n\n  return headerHeightFootprint;\n};"
        }
      ]
    },
