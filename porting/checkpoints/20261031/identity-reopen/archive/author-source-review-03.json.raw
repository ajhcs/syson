    "bytes": 3818,
    "ordinary_lines": 96,
    "source_utf8": "// SPDX-License-Identifier: EPL-2.0\n//! Independent selected-identity integration tests; no production adapter.\n//! Shared bounded process and filesystem mechanics; no expected model authority.\nuse std::{\n    fs::{self, File},\n    io::{Read, Write},\n    os::unix::fs::{MetadataExt, PermissionsExt},\n    path::Path,\n    process::{Command, Stdio},\n    thread,\n    time::{Duration, Instant},\n};\n\npub type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;\npub fn require(value: bool, message: &'static str) -> Result<()> {\n    if !value {\n        return Err(message.into());\n    }\n    Ok(())\n}\npub fn workspace_root(path: &Path) -> Result<()> {\n    require(\n        path.as_os_str().len() <= 4096 && path.is_absolute()\n            && path.starts_with(\"/workspace\") && path.canonicalize()? == path,\n        \"canonical Samsung workspace required\",\n    )?;\n    let metadata = fs::metadata(path)?;\n    let uid = fs::metadata(\"/proc/self\")?.uid();\n    require(\n        uid != 0 && metadata.uid() == uid && metadata.is_dir()\n            && metadata.permissions().mode() & 0o777 == 0o700,\n        \"owned0700 unprivileged root required\",\n    )\n}\npub fn capped(reader: impl Read, limit: u64) -> std::io::Result<Vec<u8>> {\n    let mut bytes = Vec::new();\n    reader.take(limit + 1).read_to_end(&mut bytes)?;\n    Ok(bytes)\n}\npub struct Sample {\n    pub pid: u32,\n    pub elapsed_ns: u128,\n    pub numbers: [u128; 8],\n}\n/// Fixed CLI modes/key, exclusive raw logs, bounded lifetime and output.\npub fn sample(binary: &Path, mode: &str, root: &Path, success: bool) -> Result<Sample> {\n    workspace_root(root)?;\n    require(matches!(mode, \"write\" | \"read\"), \"fixed child mode required\")?;\n    require(\n        binary.as_os_str().len() <= 4096 && binary.is_absolute()\n            && binary.canonicalize()? == binary && binary.is_file(),\n        \"canonical qualified CLI required\",\n    )?;\n    let started = Instant::now();\n    let mut child = Command::new(binary).arg(mode).arg(root).arg(\"finite\")\n        .stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;\n    let pid = child.id();\n    let status = loop {\n        let state = child.try_wait();\n        if state.is_err() {\n            let _ = child.kill();\n            let _ = child.wait();\n        }\n        if let Some(status) = state? {\n            break status;\n        }\n        if started.elapsed() > Duration::from_secs(15) {\n            let _ = child.kill();\n            let _ = child.wait();\n            return Err(\"bounded child deadline\".into());\n        }\n        thread::sleep(Duration::from_millis(2));\n    };\n    let elapsed_ns = started.elapsed().as_nanos();\n    let stdout = capped(child.stdout.take().ok_or(\"child stdout\")?, 4096)?;\n    let stderr = capped(child.stderr.take().ok_or(\"child stderr\")?, 4096)?;\n    for (name, bytes) in [(\"stdout\", &stdout), (\"stderr\", &stderr)] {\n        File::create_new(root.join(format!(\"{mode}-{pid}.{name}\")))?.write_all(bytes)?;\n    }\n    require(stdout.len() <= 4096 && stderr.len() <= 4096, \"bounded child output\")?;\n    require(status.success() == success, \"child status; raw output retained\")?;\n    let numbers = if success {\n        require(stderr.is_empty(), \"successful child stderr\")?;\n        let text = String::from_utf8(stdout)?;\n        let fields: Vec<_> = text.trim_end().split('\\t').collect();\n        require(fields.len() == 10 && fields[0] == \"M06A2/1\" && fields[1] == mode, \"child protocol\")?;\n        let values = fields[2..].iter().map(|v| v.parse::<u128>())\n            .collect::<std::result::Result<Vec<_>, _>>()?;\n        let values: [u128; 8] = values.try_into().map_err(|_| \"child numeric fields\")?;\n        require(values[0] == u128::from(pid), \"actual child PID\")?;\n        values\n    } else {\n        [0; 8]\n    };\n    Ok(Sample { pid, elapsed_ns, numbers })\n}\n",
    "classification": "PASSIVE_EXACT_PRE_FIX_SOURCE_HISTORY_ONLY_NOT_EXECUTED_OR_ACTIVE_FIXTURE"
  },
  "focused_repair": "Restore original literal wire count assertions fields[8]==12string/fields[9]==12string after10field/version/mode check. Numeric u128 parsing must not admit012. Independent test numeric12 assertions and full model oracle remain; other5files unchanged. No case/metric/guard removal."
