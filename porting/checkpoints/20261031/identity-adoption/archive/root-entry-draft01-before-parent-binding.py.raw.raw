from pathlib import Path
import hashlib
import json
import sys

ROOT = Path('/workspace/worktrees/builderbob/syson/batch54-identity-adoption-source-20261031/porting/rust-parity-plan-20261026')
PRIOR = Path('/workspace/worktrees/builderbob/syson/batch53-identity-capture-extension-20261031/porting/rust-parity-plan-20261026')
BOOTSTRAP = ROOT / 'composition/identity_partition_prepare/test_derive.py'
if BOOTSTRAP.resolve() != BOOTSTRAP or not BOOTSTRAP.is_file() or BOOTSTRAP.is_symlink():
    raise ValueError('canonical actual bootstrap required')
with BOOTSTRAP.open('rb') as stream:
    raw = stream.read(65537)
if len(raw) > 65536 or hashlib.sha256(raw).hexdigest() != '9974b003e363f729016dd4da74c2ece21cf7a3ac79c49811b6541567d0261d41':
    raise ValueError('actual bootstrap source changed')
namespace = {'__file__': str(BOOTSTRAP), '__name__': '_actual_adoption_entry'}
exec(compile(raw, str(BOOTSTRAP), 'exec'), namespace)
D, C, H = (namespace[name] for name in ['D', 'C', 'H'])
if len(sys.argv) != 3 or sys.argv[1] not in ['derive', 'norm', 'snapshot']:
    raise ValueError('fixed adoption phase and output required')
phase, output = sys.argv[1], Path(sys.argv[2])
if phase == 'derive':
    files = H.originals(PRIOR)
    files = {name: raw for name, raw in files.items() if name not in H.TAILS}
    packet = D.derive(files, H.read(ROOT, 'composition/identity_partition_prepare/fixtures/lane.json', 65536),
                      H.read(ROOT, 'composition/identity_partition_prepare/fixtures/amendment.md', 65536),
                      H.read(ROOT, 'tools/build_plan.py', 262144))
    encoded = C.compact(packet, 8 * C.MIB)
    if not output.is_absolute() or output.parent.resolve() != output.parent or output.exists() or output.is_symlink():
        raise ValueError('fresh canonical proposal output required')
    if not output.is_relative_to(C.OUTPUT_ROOT) or output.parent.stat().st_uid != ROOT.stat().st_uid:
        raise ValueError('owned Samsung proposal output required')
    output.mkdir(mode=0o700)
    with (output / 'proposal.json').open('xb') as stream:
        stream.write(encoded)
else:
    proposal = C.contract_lock() if phase == 'norm' else C.snapshot(
        'SYSON-RUST-REMAINING/2026-10-31.21', '80f6997bbdf14e061e66319e7d597a4ff50dc5d0')
    C.emit_fresh(output, proposal)
