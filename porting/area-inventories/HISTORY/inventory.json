  ],
  "behaviors": [
    {
      "id": "HISTORY-RECORDING",
      "known_source_contract_or_required_gap": "Recorder skips input if ANY ignore predicate matches; for actual EditingContext records all current ResourceSet resources pre-input, then summarize->put under input.id->endRecording post-input. Failure during record lifecycle/partial mutation must be qualified.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-IGNORE-INPUTS",
      "known_source_contract_or_required_gap": "Source predicate ignores Undo/Redo, diagram layout and a fixed list of known read-only input classes using Class.isInstance. Additional predicates can expand ignore behavior; full injection/extension closure is open.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-ID-ADDRESSING",
      "known_source_contract_or_required_gap": "EditingContext stores semantic changes in HashMap<UUID,ChangeDescription> and representation changes in separate HashMap. Native local undo/redo stacks do not implement backend input-ID lookup, EMF changes or representation handlers.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-UNDO-REDO",
      "known_source_contract_or_required_gap": "Both handlers lookup requested inputId and applyAndReverse if present, then invoke all matching representation handlers using undo/redo respectively. For matching context/input types they emit SuccessPayload and SEMANTIC_CHANGE even with no semantic change found; invalid types emit error/NOTHING. Exact handler order, duplicate calls, missing IDs and failure effects need original runtime evidence.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-REPRESENTATION-CHANGES",
      "known_source_contract_or_required_gap": "Separate recorders/handlers cover diagram layout, node/edge/label appearance, fade/hide/pin/collapse, view requests and modifiers. Source filename enumeration is not exact behavior implementation; each retained declaration requires detailed fixtures.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-CLIENT-STACKS",
      "known_source_contract_or_required_gap": "Apollo link initializes sessionStorage undo/redo stacks, pushes qualifying mutation input IDs and clears redo BEFORE forward/result, excluding operations named undo/redo/layoutDiagram. Component mount clears stacks; undo/redo sends first stack ID then moves current first entry on success, retains on ErrorPayload, and reports GraphQL errors. Concurrency/in-flight ordering and failed ordinary mutations must be qualified.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-KEYBOARD-SESSION",
      "known_source_contract_or_required_gap": "Component registers global key handlers for Ctrl/Meta+z and Ctrl/Meta+y or Shift+Z then removes listeners on cleanup. Project/context/session isolation, focus/composition/default behavior and accessibility remain crosslinked to UI/ACCESSIBILITY.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-COLLABORATION-FAILURE",
      "known_source_contract_or_required_gap": "Concurrent input replay, authorization/project isolation, redo invalidation across clients, cancellation/backpressure/event ordering and partial failure must be qualified with API/DB/MODEL. No persistent or collaborative journal equivalence follows from local snapshots or input maps.",
      "native_full_area_state": "UNPORTED"
    },
    {
      "id": "HISTORY-RESTART-DISPOSAL",
      "known_source_contract_or_required_gap": "EditingContext disposal disposes recorder, unloads resources and disposes adapter factory if supported. Source maps/client sessionStorage are not a proven durable restart history. Retention/eviction/recovery and original installed-client behavior remain open.",
      "native_full_area_state": "UNPORTED"
    }
  ],
  "runtime_execution": "NOT_RUN",
  "native_bounded_credit": "Existing syson-model local transactions/undo remain credited to MODEL; not inherited collaborative/history parity.",
  "proposed_next_split": {
    "id": "HISTORY-INPUT-STATE-CONTRACT-01",
    "kind": "SOURCE_PREPARATION",
    "scope": "Close exact ignore predicates, semantic/representation handler order, unknown/duplicate IDs and synthetic request/response/in-flight client stack fixtures before defining native history API.",
    "state": "PROPOSED_NOT_LEASED"
  },
  "unclosed_surface": [
    "All representation recorder/handler implementation and extensions.",
    "Source/artifact correspondence and actual schema/controller/event registration.",
    "Exact error/partial failure/cancel/retry/concurrency and access/isolation behavior.",
    "Retention, restart, event persistence and recovery semantics.",
    "Client/session/focus/keyboard behavior and real-user acceptance.",
    "Distinct source review, native implementation and original/runtime differential evidence."
  ]
