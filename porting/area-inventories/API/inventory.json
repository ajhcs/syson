  "behaviors": [
    {
      "id": "API-LOCAL-GRAPHQL",
      "known_source_contract": "Four local SDL documents and15 exact data-fetcher declarations; non-null/optional input distinctions, payload unions and editing-context IDs are native wire obligations. Several Mutation coordinates use QueryDataFetcher annotation; do not infer read-only behavior from annotation name.",
      "state": "UNPORTED"
    },
    {
      "id": "API-MUTATION-DISPATCH",
      "known_source_contract": "Inspected deleteExpression fetcher converts input with ObjectMapper then uses exceptionWrapper.wrapMono around editingContextDispatcher.dispatchMutation(...).toFuture(). DTO validation, exception mapping and cancellation require inherited wiring closure.",
      "state": "UNPORTED"
    },
    {
      "id": "API-REST-OBJECTS",
      "known_source_contract": "SysON object delegate canHandle=true; roots unwrap root namespaces from nonlibrary resources; traversal omits implied Relationship objects but does not prune their descendants. Incoming/outgoing relationships use HashSet and omit implied relationships; do not assert stable list order.",
      "state": "UNPORTED"
    },
    {
      "id": "API-REST-VERSIONING",
      "known_source_contract": "SysON delegates createCommit and branch operations to inherited service; deleteBranch delegates getBranchById. Commit-change list accepts only absent/empty changeTypes and commitID matching projectID; IDs use UUID.nameUUIDFromBytes(concatenation with default charset). By-ID path has separate null conditions. Candidate default service applies current-state changes; createCommit is not proven no-op.",
      "state": "UNPORTED"
    },
    {
      "id": "API-REST-SERIALIZATION",
      "known_source_contract": "SysMLv2JsonSerializer/SysMLv2SerializerConfig and inherited object serializers must be reconciled with model metadata, references, cycles, IDs, errors and wire shape. Declared filenames are not serializer equivalence.",
      "state": "UNPORTED"
    },
    {
      "id": "API-WEBSOCKET-SESSION",
      "known_source_contract": "Candidate registers subscription endpoint with configurable allowedOriginPatterns and100000 text/binary buffer sizes; advertises graphql-ws,28-second keepalive. Per-session subscriptions and keepalive disposables are separate maps.",
      "state": "UNPORTED"
    },
    {
      "id": "API-WEBSOCKET-CANCEL",
      "known_source_contract": "Candidate parses init/start/stop/terminate by type, malformed/unknown messages send connection_error. Terminate message branch constructs handler without invoking handle; connection close invokes handle and disposes keepalive. Preserve this actual source distinction for qualification; no behavior correction authorized.",
      "state": "UNPORTED"
    },
    {
      "id": "API-COLLABORATIVE-EVENTS",
      "known_source_contract": "Candidate editing-context processor submits work to its executor and waits on Future.get; shutdown returns Mono.empty; InterruptedException/ExecutionException are logged. Output/change/disposal sinks have distinct multicast/unicast modes; disposal shuts executor, representation registry and editing context.",
      "state": "UNPORTED"
    },
    {
      "id": "API-AUTH-SESSION-ISOLATION",
      "known_source_contract": null,
      "required_qualification": "Resolve actual authentication, authorization, cookies/session/CSRF/origins/project isolation and proxy/deployment policy across inherited modules and deployment. Bounded filename/token searches did not establish an authentication contract; absence of hits cannot establish absence of checks.",
      "state": "UNRESOLVED"
    },
    {
      "id": "API-ERROR-RETRY-DEPLOYMENT",
      "known_source_contract": null,
      "required_qualification": "Map conversion/nullability/error payload/HTTP status, subscription lifetime/cancel/backpressure/concurrency/retry/idempotency, interrupted partial mutations, process shutdown and deployment/rollback. Crosslinks to MODEL/DB/HISTORY/RECOVERY/DEPS do not drop API responsibility.",
      "state": "UNRESOLVED"
    }
  ],
