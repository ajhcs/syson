  "actual_native_semantics": [
    {
      "source": "backend/application/syson-sysml-import/src/main/resources/syside-cli.js:13550-13586; Langium streamContents",
      "behavior": "Enumerates own properties in Object.keys insertion order, excludes every property starting with $, yields AST node values and array AST entries. Primitive values and unresolved reference descriptors are not child AST nodes. Cache aliases therefore must not recursively become containment."
    },
    {
      "source": "same bundle:108958-108983; SysMLParser collectChildren/fillNode/construct",
      "behavior": "Clears $children, repopulates it from streamContents, stably sorts by compareRanges(child.$cstNode?.range), then writes each child.$childIndex. Both fillNode and construct can rebuild the cache. The same node identities occur in authoritative properties and this non-owning cache."
    },
    {
      "source": "same bundle:83732-83758; streamAllContents/streamAst/compareRanges",
      "behavior": "The real native generic AST walkers consume $children. Range comparison uses only start.line and start.character; missing range uses(0,0). It does not compare ends. Equal-start ordering preserves the prior stream order. Native helper streamAst includes the root; streamAllContents does not."
    },
    {
      "source": "same bundle:13493-13510 and107310-107352; linkContentToContainer/assignNode",
      "behavior": "$containerProperty names the authoritative owning property. $containerIndex is the index inside that property array and is absent for scalar containment. $childIndex is position in the separately ordered child cache. Do not substitute one for the other or add a root index that is absent in parsed native output."
    },
    {
      "source": "same bundle:107273-107307; reflection assignMandatoryProperties/createNode",
      "behavior": "Programmatically created nodes can receive a default $childIndex=0; the actual parsed Namespace root in the retained capture lacks that property. Preserve own-property presence and the differing construction routes."
    },
    {
      "source": "same bundle:107337-107351; reflection assignNode incremental cache branch",
      "behavior": "When a CST insertion point is found, source splices child into parent.$children and subsequently executes an unconditional push of child. This condition can yield repeated non-owning aliases and last-written $childIndex. Source proves the conditional consequence; capture actual original-method and real-caller reachability before defining compatibility or an intentional improvement. Do not assume cache uniqueness globally."
    },
    {
      "source": "rust/crates/syson-ast/src/lib.rs on main:Builder::finish; Node::fields/Container",
      "behavior": "Every Value::Node, including one inside an array, is treated as containment. The seen set rejects repeated containment; cycles and foreign owners remain errors. Fields are a BTreeMap, so lexical key order cannot substitute for native property insertion order in equal/missing-CST ties."
    }
  ],
  "proposed_design_contract": {
    "authority": "Existing semantic properties own nodes. Derived cache entries refer to those nodes; they never own or clone AST nodes and never allocate new NodeIds. Keep repeated-containment, cycle, foreign-owner, spent-ID and rollback invariants unchanged.",
    "surface": "A public AST projection/cache view over an immutable Arena, with explicit derived children and optional child_index accessors; borrowed references or owner-qualified handles are acceptable. Scalar/array container metadata remains read from authoritative containment. Native-compatible export/navigation must call the public projection, not an oracle-only reconstructed expectation.",
    "raw_slots": "Leave the physical kernel $children default and the original F11 expectation of[] intact in these first children. Expose raw fields alongside the derived projection in evidence. A later decision to change Node::slot/fields behavior is a separately reviewed API/representation change, not an expectation deletion.",
    "ordering": "Implement native start-range ordering and preserve encounter order for ties. Do not use BTreeMap order, NodeId/allocation order or end offsets as an invented tie-breaker. P13 must supply any missing construction-order provenance for mixed-field/action cases. Bound or explicitly leave unsupported an unqualified family; no full P14 acceptance follows from a finite projection.",
    "lifecycle": "Prefer building a local projection only after successful Arena freeze. Publish no partial projection on limits/cancellation. A new Arena gets its own projection; old immutable Arena/view remains valid. Mutable pre-freeze caches, action alias changes and incremental reflection assignment require their own reviewed behavior family.",
    "accounting": "Charge projection vector/map/order work before reservation; bound nodes/edges/labels and poll cancellation inside long traversals. Record requested allocation and separate live/RSS observations. Do not infer a deadline, native capacity or global heap bound."
  },
